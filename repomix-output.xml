class NavigationSystem {
  constructor() {
    this.navData       = null;
    this.currentPath   = null;
    this.pathNodes     = [];
    this.isNavigating  = false;
    this.activeKiosk   = 'kiosk1'; // Guard House by default
    this.ORIG_W        = 1050;
    this.ORIG_H        = 1050;
  }

  async init() {
    try {
      // Check for kiosk ID in the URL, e.g., index.html?kiosk=kiosk2
      const urlParams = new URLSearchParams(window.location.search);
      const kioskParam = urlParams.get('kiosk');
      if (kioskParam && this.activeKiosk !== kioskParam) {
        console.log(` Setting active kiosk to: ${kioskParam}`);
        this.activeKiosk = kioskParam;
      }

      const res = await fetch('/navigation.json?t=' + Date.now());
      if (!res.ok) throw new Error('Failed to load navigation data');
      this.navData = await res.json();
      console.log(' Navigation loaded —',
        this.navData.nodes.length, 'nodes,',
        this.navData.edges.length, 'edges'
      );
    } catch (e) {
      console.error(' Navigation load error:', e.message);
      return false;
    }

    this._setupOverlay();
    this._injectStyles();

    window.addEventListener('resize', () => {
      this._syncOverlay();
      if (this.currentPath) this._drawPath(this.currentPath);
    });
    return true;
  }

  //  NAVIGATE TO BUILDING 
  navigateTo(buildingId) {
    if (!this.navData) return false;

    const dest = this.navData.nodes.find(n => n.buildingId === buildingId);
    if (!dest) {
      console.warn(`No navigation node for building: ${buildingId}`);
      return false;
    }

    const startId = this.navData.kiosks[this.activeKiosk];
    if (!startId) { console.warn('No kiosk start node set'); return false; }

    const path = window.dijkstra.findShortestPath(
      startId, dest.id,
      this.navData.nodes,
      this.navData.edges
    );

    if (!path) {
      console.warn(`No path found to ${buildingId}`);
      if (window.app && window.app.ui && window.app.ui.showToast) {
        window.app.ui.showToast('📍 Destination path not yet mapped on the road network.', 'warning');
      }
      return false;
    }

    this.currentPath  = path;
    this.pathNodes    = path.map(id => this.navData.nodes.find(n => n.id === id)).filter(Boolean);
    this.isNavigating = true;
    
    this._drawPath(path);
    this.updateInstructionUI(dest.name);
    this.showCard();
    return true;
  }

  updateInstructionUI(buildingName) {
    const nextText = document.getElementById('navNextText');
    const directionText = document.getElementById('navDirectionText');
    if (nextText) nextText.textContent = buildingName;

    if (directionText && this.currentPath) {
      const steps = this.currentPath.length;
      const minutes = Math.max(1, Math.round(steps * 0.3));
      directionText.innerHTML = `
        <div style="font-size:0.8rem; opacity:0.8; margin-bottom:4px;">Follow the highlighted path</div>
        <div style="font-size:0.9rem; margin-top:6px; color:#666;">Approx. ~${minutes} min walk</div>
      `;
    }
  } 

  showCard() {
    document.getElementById('navInstructionCard')?.classList.add('active');
  }

  hideCard() {
    document.getElementById('navInstructionCard')?.classList.remove('active');
  }

  //  CLEAR 
  clearNavigation() {
    this.currentPath  = null;
    this.pathNodes    = [];
    this.isNavigating = false;
    const pg = document.getElementById('nav-path-g');
    const mg = document.getElementById('nav-markers-g');
    if (pg) pg.innerHTML = '';
    if (mg) mg.innerHTML = '';
  }

  //  SETUP SVG OVERLAY 
  _setupOverlay() {
    const wrapper = document.getElementById('mapWrapper');
    if (!wrapper || document.getElementById('nav-overlay')) return;

    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.id = 'nav-overlay';
    svg.style.cssText = `
      position:absolute; top:0; left:0;
      width:100%; height:100%;
      pointer-events:none; z-index:1000;
    `;

    const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
    defs.innerHTML = `
      <marker id="nav-arrow" markerWidth="6" markerHeight="4"
        refX="5" refY="2" orient="auto">
        <polygon points="0 0, 6 2, 0 4" fill="#ffffff" stroke="#003DA5" stroke-width="0.5"/>
      </marker>
    `;
    svg.appendChild(defs);

    const pathG = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    pathG.id = 'nav-path-g';
    svg.appendChild(pathG);

    const markersG = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    markersG.id = 'nav-markers-g';
    svg.appendChild(markersG);

    wrapper.appendChild(svg);
    this._syncOverlay();
  }

  _syncOverlay() {
    const svg    = document.getElementById('nav-overlay');
    const siteMap = document.getElementById('siteMap');
    if (!svg || !siteMap) return;
    const w = siteMap.offsetWidth;
    const h = siteMap.offsetHeight;
    if (!w || !h) return;
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    svg.style.width  = w + 'px';
    svg.style.height = h + 'px';
  }

  //  DRAW PATH 
  _drawPath(pathIds) {
    const pathG   = document.getElementById('nav-path-g');
    const markersG = document.getElementById('nav-markers-g');
    const siteMap  = document.getElementById('siteMap');
    if (!pathG || !markersG || !siteMap) return;

    pathG.innerHTML   = '';
    markersG.innerHTML = '';

    const mapW = siteMap.offsetWidth;
    const mapH = siteMap.offsetHeight;

    const toSvg = (node) => ({
      x: (node.x / this.ORIG_W) * mapW,
      y: (node.y / this.ORIG_H) * mapH
    });

    // Always Draw "YOU ARE HERE" for Active Kiosk 
    const startNodeId = this.navData.kiosks[this.activeKiosk];
    const startNode = this.navData.nodes.find(n => n.id === startNodeId);
    if (startNode) {
      const sp = toSvg(startNode);
      this._drawYouAreHere(markersG, sp);
    }

    if (!this.isNavigating || !this.currentPath) return;

    if (this.pathNodes.length < 2) return;

    // Build smooth curved path instead of sharp corners
    let d = '';
    if (this.pathNodes.length === 2) {
      const s = toSvg(this.pathNodes[0]);
      const e = toSvg(this.pathNodes[1]);
      d = `M${s.x},${s.y} L${e.x},${e.y}`;
    } else {
      this.pathNodes.forEach((node, i) => {
        const p = toSvg(node);
        if (i === 0) {
          d += `M${p.x},${p.y}`;
        } else if (i === this.pathNodes.length - 1) {
          d += ` L${p.x},${p.y}`;
        } else {
          // Smooth curve through intermediate points
          const next = toSvg(this.pathNodes[i + 1]);
          const cpX  = p.x;
          const cpY  = p.y;
          d += ` Q${cpX},${cpY} ${(p.x + next.x) / 2},${(p.y + next.y) / 2}`;
        }
      });
    }

    const glowPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    glowPath.setAttribute('d', d);
    glowPath.setAttribute('stroke', 'rgba(0,61,165,0.35)');
    glowPath.setAttribute('stroke-width', '16');
    glowPath.setAttribute('fill', 'none');
    glowPath.setAttribute('stroke-linecap', 'round');
    glowPath.setAttribute('stroke-linejoin', 'round');
    pathG.appendChild(glowPath);

    const mainPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    mainPath.setAttribute('d', d);
    mainPath.setAttribute('class', 'nav-active-segment');
    mainPath.setAttribute('fill', 'none');
    mainPath.setAttribute('marker-end', 'url(#nav-arrow)');
    mainPath.setAttribute('stroke', '#ffffff');
    
    // Calculate length for the "draw-in" effect
    const length = mainPath.getTotalLength();
    mainPath.style.strokeDasharray = length;
    mainPath.style.strokeDashoffset = length;
    mainPath.style.animation = `navDrawIn 1.5s ease-out forwards, navDash 0.8s linear infinite`;
    
    pathG.appendChild(mainPath);

    // ── 3. Destination Marker ──
    const endNode = this.pathNodes[this.pathNodes.length - 1];
    const ep = toSvg(endNode);
    const pin = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    pin.setAttribute('cx', ep.x); pin.setAttribute('cy', ep.y);
    pin.setAttribute('r', '10'); pin.setAttribute('fill', '#E74C3C');
    pin.setAttribute('stroke', '#ffffff'); pin.setAttribute('stroke-width', '2.5');
    pin.setAttribute('class', 'nav-dest-pin');
    // Delay pin appearance until line reaches it
    pin.style.opacity = '0';
    pin.style.animation = 'fadeIn 0.5s ease forwards';
    pin.style.animationDelay = '1.3s';
    markersG.appendChild(pin);

    const destLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    destLabel.setAttribute('x', ep.x);
    destLabel.setAttribute('y', ep.y - 18);
    destLabel.setAttribute('text-anchor', 'middle');
    destLabel.setAttribute('fill', '#FFD700');
    destLabel.setAttribute('font-size', '12');
    destLabel.setAttribute('font-weight', 'bold');
    destLabel.setAttribute('paint-order', 'stroke');
    destLabel.setAttribute('stroke', '#000000');
    destLabel.setAttribute('stroke-width', '3.5');
    destLabel.textContent = endNode.name.replace(' Entrance', '');
    destLabel.style.opacity = '0';
    destLabel.style.animation = 'fadeIn 0.5s ease forwards';
    destLabel.style.animationDelay = '1.5s';
    markersG.appendChild(destLabel);
  }

  _drawYouAreHere(container, pos) {
    // Continuous sonar rings
    [1, 2].forEach(i => {
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      p.setAttribute('cx', pos.x); p.setAttribute('cy', pos.y);
      p.setAttribute('r', '12'); p.setAttribute('fill', 'none');
      p.setAttribute('stroke', '#003DA5'); p.setAttribute('stroke-width', '2');
      p.setAttribute('class', `nav-pulse-${i}`);
      container.appendChild(p);
    });

    // Background for contrast
    const bg = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    bg.setAttribute('cx', pos.x); bg.setAttribute('cy', pos.y);
    bg.setAttribute('r', '13'); bg.setAttribute('fill', '#ffffff');
    container.appendChild(bg);

    // Main marker
    const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    dot.setAttribute('cx', pos.x); dot.setAttribute('cy', pos.y);
    dot.setAttribute('r', '10'); dot.setAttribute('fill', '#003DA5');
    dot.setAttribute('stroke', '#ffffff'); dot.setAttribute('stroke-width', '2.5');
    container.appendChild(dot);

    // Center point
    const inner = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    inner.setAttribute('cx', pos.x); inner.setAttribute('cy', pos.y);
    inner.setAttribute('r', '4'); inner.setAttribute('fill', '#ffffff');
    container.appendChild(inner);

    const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    label.setAttribute('x', pos.x); label.setAttribute('y', pos.y - 20);
    label.setAttribute('text-anchor', 'middle'); label.setAttribute('fill', '#ffffff');
    label.setAttribute('font-size', '11'); label.setAttribute('font-weight', 'bold');
    label.setAttribute('paint-order', 'stroke'); label.setAttribute('stroke', '#003DA5');
    label.setAttribute('stroke-width', '4');
    label.textContent = 'YOU ARE HERE';
    container.appendChild(label);
  }

  //  CSS ANIMATIONS
  _injectStyles() {
    if (document.getElementById('nav-styles')) return;
    const style = document.createElement('style');
    style.id = 'nav-styles';
    style.textContent = `
      .nav-active-segment {
        stroke: #ffffff;
        stroke-width: 6;
        stroke-linecap: round;
        stroke-linejoin: round;
        filter: drop-shadow(0 0 5px rgba(0, 0, 0, 0.8));
      }
      
      @keyframes navDrawIn {
        to { stroke-dashoffset: 0; }
      }

      @keyframes navDash {
        from { stroke-dasharray: 10, 10; stroke-dashoffset: 0; }
        to   { stroke-dasharray: 10, 10; stroke-dashoffset: -20; }
      }
      
      /* Sonar Pulse Animation */
      .nav-pulse-1, .nav-pulse-2 {
        transform-box: fill-box;
        transform-origin: center;
        animation: navSonar 2s ease-out infinite;
      }
      .nav-pulse-2 { animation-delay: 1s; }
      @keyframes navSonar {
        0%   { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(3); opacity: 0; }
      }

      .nav-dest-pin {
        animation: navBounce 1s ease-in-out infinite alternate;
      }
      @keyframes navBounce {
        from { transform: translateY(0); }
        to   { transform: translateY(-4px); }
      }
      @keyframes fadeIn {
        to { opacity: 1; }
      }
    `;
    document.head.appendChild(style);
  }

  stopNavigation() {
    this.clearNavigation();
    this.hideCard();

    const btn = document.getElementById('getDirectionsBtn');
    if (btn) {
      btn.innerHTML = '<i class="fas fa-route"></i> Get Directions';
      btn.style.background = 'var(--white)';
      btn.style.color = 'var(--primary-blue)';
    }
  }
}

