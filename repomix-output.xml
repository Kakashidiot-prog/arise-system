function drawBuildingOverlays() {
  const svg     = document.getElementById('buildingOverlay');
  const siteMap = document.getElementById('siteMap');
  if (!svg || !siteMap) return;

  svg.innerHTML = '';
  const mapW = siteMap.offsetWidth;
  const mapH = siteMap.offsetHeight;
  if (mapW === 0 || mapH === 0) {
    setTimeout(() => drawBuildingOverlays(), 200);
    return;
  }

  svg.setAttribute('viewBox', `0 0 ${mapW} ${mapH}`);
  svg.style.width  = mapW + 'px';
  svg.style.height = mapH + 'px';

  const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;

  Object.values(window.app.buildingsData).forEach(building => {
    try {
      if (window.app.activeFilter !== 'all' && (building.category || '').toLowerCase() !== window.app.activeFilter.toLowerCase()) return;
      if (!building.coordinates || building.coordinates.length < 3) return;

      const polygon = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      const points  = building.coordinates.map(c =>
        `${(c.x / window.app.originalMapWidth)  * mapW},` +
        `${(c.y / window.app.originalMapHeight) * mapH}`
      ).join(' ');

      polygon.setAttribute('points', points);
      polygon.setAttribute('data-building-id', building.id);
      polygon.setAttribute('class', 'building-area');

      polygon.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isTouchDevice) {
          if (window.app.tappedBuilding === building.id) {
            window.app.hideTooltip();
            window.app.showBuildingDetails(building.id);
            window.app.tappedBuilding = null;
            clearTimeout(window.app._tappedBuildingTimer);
          } else {
            window.app.showTooltip(building, e);
            window.app.tappedBuilding = building.id;
            clearTimeout(window.app._tappedBuildingTimer);
            window.app._tappedBuildingTimer = setTimeout(() => {
              window.app.hideTooltip();
              if (window.app.tappedBuilding === building.id) window.app.tappedBuilding = null;
            }, 3000);
          }
        } else {
          window.app.showBuildingDetails(building.id);
        }
      });

      if (!isTouchDevice) {
        polygon.addEventListener('mouseenter', (e) => window.app.showTooltip(building, e));
        polygon.addEventListener('mousemove',  (e) => window.app.moveTooltip(e));
        polygon.addEventListener('mouseleave', ()  => window.app.hideTooltip());
      }

      svg.appendChild(polygon);
    } catch (err) {
      console.error('Error drawing building:', building.id, err);
    }
  });
}

function setupMapPinchZoom() {
  const wrapper = document.getElementById('mapWrapper');
  const map     = document.getElementById('siteMap');
  const svg     = document.getElementById('buildingOverlay');
  const navSvg  = document.getElementById('navigationOverlay');
  if (!wrapper || !map || !svg) return;

  let scale = 1, ox = 0, oy = 0;
  let lastDist = null, lastMid = null, isPinching = false;
  const MIN = 1, MAX = 4;

  const clamp = () => {
    if (scale <= 1) { ox = 0; oy = 0; return; }
    const wW = wrapper.offsetWidth, wH = wrapper.offsetHeight;
    ox = Math.min(0, Math.max(wW - wW * scale, ox));
    oy = Math.min(0, Math.max(wH - wH * scale, oy));
  };

  const apply = (animate = false) => {
    const t  = `translate(${ox}px,${oy}px) scale(${scale})`;
    const tr = animate ? 'transform 0.3s ease' : 'none';
    map.style.transition = svg.style.transition = tr;
    map.style.transform  = svg.style.transform  = t;
    map.style.transformOrigin = svg.style.transformOrigin = '0 0';
    
    if (navSvg) {
        navSvg.style.transition = tr;
        navSvg.style.transform = t;
        navSvg.style.transformOrigin = '0 0';
    }
  };

  const pdist = (t) => Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
  const pmid  = (t) => ({ x: (t[0].clientX + t[1].clientX) / 2, y: (t[0].clientY + t[1].clientY) / 2 });

  window.app._mapZoomReset = (animate = true) => { scale = 1; ox = 0; oy = 0; apply(animate); };

  wrapper.addEventListener('touchstart', (e) => {
    if (e.touches.length === 2) {
      isPinching = true;
      lastDist   = pdist(e.touches);
      lastMid    = pmid(e.touches);
      e.preventDefault();
    }
  }, { passive: false });

  wrapper.addEventListener('touchmove', (e) => {
    if (e.touches.length !== 2 || !isPinching) return;
    e.preventDefault();
    const newDist = pdist(e.touches);
    const newMid  = pmid(e.touches);
    const ratio   = newDist / lastDist;
    const wRect   = wrapper.getBoundingClientRect();
    const fx = newMid.x - wRect.left;
    const fy = newMid.y - wRect.top;
    const ns = Math.min(MAX, Math.max(MIN, scale * ratio));
    const sc = ns / scale;
    ox = fx - sc * (fx - ox);
    oy = fy - sc * (fy - oy);
    scale = ns;
    ox += newMid.x - lastMid.x;
    oy += newMid.y - lastMid.y;
    clamp();
    apply();
    lastDist = newDist;
    lastMid  = newMid;
  }, { passive: false });

  wrapper.addEventListener('touchend', (e) => {
    if (e.touches.length < 2) { isPinching = false; lastDist = null; lastMid = null; }
  }, { passive: true });

  let panStart = null, originAtPan = null;

  wrapper.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1 && scale > 1.05) {
      panStart    = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      originAtPan = { x: ox, y: oy };
    }
  }, { passive: true });

  wrapper.addEventListener('touchmove', (e) => {
    if (e.touches.length !== 1 || !panStart || scale <= 1.05) return;
    const dx = e.touches[0].clientX - panStart.x;
    const dy = e.touches[0].clientY - panStart.y;
    if (Math.abs(dx) > 8 || Math.abs(dy) > 8) {
      e.preventDefault();
      ox = originAtPan.x + dx;
      oy = originAtPan.y + dy;
      clamp();
      apply();
    }
  }, { passive: false });

  wrapper.addEventListener('touchend', () => { panStart = null; }, { passive: true });
}
