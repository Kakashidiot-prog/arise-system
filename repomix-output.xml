// POST bulk replace — deletes all existing points for a building then inserts new ones
router.post('/bulk/:building_id', async (req, res) => {
  const { building_id } = req.params;
  const { coordinates } = req.body;

  if (!coordinates || !Array.isArray(coordinates)) {
    return res.status(400).json({ error: 'coordinates array required' });
  }

  if (coordinates.length < 3) {
    return res.status(400).json({ error: 'Need at least 3 points' });
  }

  try {
    const conn = await pool.getConnection();
    await conn.execute(
      'DELETE FROM coordinates WHERE building_id = ?',
      [building_id]
    );
    for (let i = 0; i < coordinates.length; i++) {
