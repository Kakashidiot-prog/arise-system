const express = require('express');
const router  = express.Router();
const multer  = require('multer');
const ftp     = require('basic-ftp');
const fs      = require('fs');
const path    = require('path');

// Configure temporary storage
const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    // Save to a temp folder to keep the main images folder clean
    const tempDir = path.join(__dirname, '../../public/images/temp');
    if (!fs.existsSync(tempDir)) fs.mkdirSync(tempDir, { recursive: true });
    cb(null, tempDir);
  },
  filename: (req, file, cb) => {
    const cleanName = file.originalname.replace(/[^a-zA-Z0-9.-]/g, '_');
    cb(null, `${Date.now()}-${cleanName}`);
  }
});

const upload = multer({ storage });

/**
 * Helper to handle FTP upload
 */
async function uploadToFTP(localPath, fileName, folder) {
  const client = new ftp.Client();
  try {
    await client.access({
      host:     process.env.FTP_HOST,
      user:     process.env.FTP_USER,
      password: process.env.FTP_PASS,
      secure:   false
    });
    
    const remoteDir = `${process.env.FTP_BASE_PATH || '/fis'}/${folder}`;
    await client.ensureDir(remoteDir);
    await client.uploadFrom(localPath, fileName);
    
    return true;
  } catch (err) {
    console.error('FTP Upload Error:', err.message);
    throw err;
  } finally {
    client.close();
  }
}

// POST /api/admin/upload
router.post('/', upload.single('image'), async (req, res) => {
  if (!req.file) return res.status(400).json({ error: 'No file uploaded' });

  const isPdf = req.file.mimetype === 'application/pdf';
  const folder = isPdf ? 'pdf' : 'pix';

  try {
    // 1. Send to FTP Primary Storage
    await uploadToFTP(req.file.path, req.file.filename, folder);

    // 2. Instead of deleting, we move it from 'temp' to 'public/images' 
    // so the frontend can serve it instantly without hitting FTP.
    const finalDir = path.join(__dirname, '../../public/images');
    if (!fs.existsSync(finalDir)) fs.mkdirSync(finalDir, { recursive: true });
    
    const finalPath = path.join(finalDir, req.file.filename);
    fs.renameSync(req.file.path, finalPath);

    // 3. Success response 
    res.json({ 
      path: `images/${req.file.filename}`, 
      message: 'Upload successful (Stored on FTP & Local Cache)' 
    });

  } catch (error) {
    console.error('Upload Process Error:', error);
    res.status(500).json({ error: 'Failed to process upload to FTP server' });
  }
});

module.exports = router;
</file>

