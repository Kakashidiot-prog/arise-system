  openLightbox(images, startIndex = 0) {
  const existing = document.getElementById('pgc-lightbox');
  if (existing) existing.remove();

  // accept single string or array
  const imgArray = Array.isArray(images) ? images : [images];
  let current    = startIndex;

  const overlay = document.createElement('div');
  overlay.id = 'pgc-lightbox';
  overlay.style.cssText = `
    position:fixed; inset:0; background:rgba(0,0,0,0.85);
    backdrop-filter:blur(8px); z-index:99999;
    display:flex; align-items:center; justify-content:center;
    animation:fadeIn 0.25s ease; touch-action:none;
  `;

  // close button
  const closeBtn = document.createElement('button');
  closeBtn.innerHTML = '✕';
  closeBtn.style.cssText = `
    position:absolute; top:20px; right:20px;
    background:#E74C3C; border:none; color:#fff;
    width:56px; height:56px; border-radius:50%;
    font-size:1.5rem; cursor:pointer; z-index:10;
    display:flex; align-items:center; justify-content:center;
    touch-action:manipulation;
  `;

  // counter  e.g. "2 / 5"
  const counter = document.createElement('div');
  counter.style.cssText = `
    position:absolute; top:24px; left:50%;
    transform:translateX(-50%);
    background:rgba(0,0,0,0.6); color:#fff;
    padding:6px 16px; border-radius:20px;
    font-size:14px; font-weight:600; z-index:10;
    display:${imgArray.length > 1 ? 'block' : 'none'};
  `;

  // image wrapper
  const imgWrap = document.createElement('div');
  imgWrap.style.cssText = `
    max-width:92vw; max-height:88vh;
    display:flex; align-items:center; justify-content:center;
    position:relative;
  `;
  imgWrap.addEventListener('click', e => e.stopPropagation());

  const img = document.createElement('img');
  img.style.cssText = `
    max-width:92vw; max-height:88vh; object-fit:contain;
    border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,0.6);
    touch-action:none; user-select:none;
    transition: opacity 0.2s ease;
  `;

  // prev button
  const prevBtn = document.createElement('button');
  prevBtn.innerHTML = '&#8249;';
  prevBtn.style.cssText = `
    position:absolute; left:-70px; top:50%;
    transform:translateY(-50%);
    background:rgba(255,255,255,0.15); border:2px solid rgba(255,255,255,0.3);
    color:#fff; width:56px; height:56px; border-radius:50%;
    font-size:2rem; cursor:pointer; z-index:10;
    display:${imgArray.length > 1 ? 'flex' : 'none'};
    align-items:center; justify-content:center;
    touch-action:manipulation; transition:background 0.2s;
  `;
  prevBtn.onmouseenter = () => prevBtn.style.background = 'rgba(255,255,255,0.3)';
  prevBtn.onmouseleave = () => prevBtn.style.background = 'rgba(255,255,255,0.15)';

  // next button
  const nextBtn = document.createElement('button');
  nextBtn.innerHTML = '&#8250;';
  nextBtn.style.cssText = `
    position:absolute; right:-70px; top:50%;
    transform:translateY(-50%);
    background:rgba(255,255,255,0.15); border:2px solid rgba(255,255,255,0.3);
    color:#fff; width:56px; height:56px; border-radius:50%;
    font-size:2rem; cursor:pointer; z-index:10;
    display:${imgArray.length > 1 ? 'flex' : 'none'};
    align-items:center; justify-content:center;
    touch-action:manipulation; transition:background 0.2s;
  `;
  nextBtn.onmouseenter = () => nextBtn.style.background = 'rgba(255,255,255,0.3)';
  nextBtn.onmouseleave = () => nextBtn.style.background = 'rgba(255,255,255,0.15)';

  // go to image
  const goTo = (index) => {
    current = (index + imgArray.length) % imgArray.length;
    img.style.opacity = '0';
    setTimeout(() => {
      img.src = imgArray[current];
      img.style.opacity = '1';
    }, 150);
    counter.textContent = `${current + 1} / ${imgArray.length}`;
  };

  prevBtn.addEventListener('click', e => { e.stopPropagation(); goTo(current - 1); });
  nextBtn.addEventListener('click', e => { e.stopPropagation(); goTo(current + 1); });

  // keyboard navigation
  const onKey = (e) => {
    if (e.key === 'ArrowLeft')  goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
    if (e.key === 'Escape')     closeLightbox();
  };
  document.addEventListener('keydown', onKey);

  // swipe support
  let swipeX = 0;
  overlay.addEventListener('touchstart', e => { swipeX = e.touches[0].clientX; }, { passive: true });
  overlay.addEventListener('touchend', e => {
    const dx = swipeX - e.changedTouches[0].clientX;
    if (Math.abs(dx) > 50) goTo(dx > 0 ? current + 1 : current - 1);
  }, { passive: true });

  const closeLightbox = () => {
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKey);
    this._searchResultJustTapped = true;
    overlay.style.opacity    = '0';
    overlay.style.transition = 'opacity 0.2s ease';
    setTimeout(() => {
      if (overlay.parentNode) overlay.remove();
      this._searchResultJustTapped = false;
    }, 200);
  };

  closeBtn.addEventListener('click', e => { e.stopPropagation(); closeLightbox(); });
  overlay.addEventListener('click', e => { if (e.target === overlay) closeLightbox(); });

  // initial render
  img.src = imgArray[current];
  counter.textContent = `${current + 1} / ${imgArray.length}`;

  imgWrap.append(prevBtn, img, nextBtn);
  overlay.append(closeBtn, counter, imgWrap);
  document.body.appendChild(overlay);
  document.body.style.overflow = 'hidden';
}

