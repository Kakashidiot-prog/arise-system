function openModal(id)  { document.getElementById(id).classList.add('open');    }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

document.querySelectorAll('.modal-overlay').forEach(el => {
  el.addEventListener('click', e => { if (e.target === el) closeModal(el.id); });
});

function toast(msg, type = 'success') {
  const el = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  el.className = `show ${type}`;
  setTimeout(() => el.classList.remove('show'), 3000);
}

function esc(s) {
  return String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function filterTable(tbodyId, q, cols) {
  const tbody = document.getElementById(tbodyId);
  const term  = q.toLowerCase();
  tbody.querySelectorAll('tr').forEach(row => {
    const text = cols.map(i => row.cells[i]?.textContent || '').join(' ').toLowerCase();
    row.style.display = text.includes(term) ? '' : 'none';
  });
}

function confirmDelete(type, id, label) {
  document.getElementById('confirm-title').textContent = `Delete ${type}?`;
  document.getElementById('confirm-msg').textContent   = `"${label}" will be permanently removed.`;
  const old   = document.getElementById('confirm-ok');
  const fresh = old.cloneNode(true);
  old.parentNode.replaceChild(fresh, old);
  fresh.addEventListener('click', async () => {
    const data = await apiFetch(`/${type}s/${id}`, { method: 'DELETE' });
    closeModal('confirm-modal');
    if (!data || data.error) return toast(data?.error || 'Delete failed', 'error');
    toast(`${type} deleted`, 'success');
    if (type === 'building')                         { loadBuildings(); loadDashboard(); }
    else if (type === 'floor' || type === 'office')    loadFloorsPage();
    else if (type === 'image')                         loadImages();
    else if (type === 'coordinate')                    loadCoordinates();
  });
  openModal('confirm-modal');
}

