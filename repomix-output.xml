<body>
    <div class="container">
        <h1>🎯 Building Coordinate Finder Tool</h1>
        <p class="subtitle">Click the 4 corners of each building to get exact coordinates for buildings-data.js</p>

        <div class="instructions">
            <h3>📝 Instructions:</h3>
            <ol>
                <li><strong>Click 4 corners</strong> of the building in this order: Top-Left → Top-Right → Bottom-Right → Bottom-Left</li>
                <li>Red markers will appear at each click to show your progress</li>
                <li>After 4 clicks, the coordinates will be generated automatically</li>
                <li>Click <strong>"Copy Coordinates"</strong> to copy the code</li>
                <li>Paste into your <code>buildings-data.js</code> file</li>
                <li>Click <strong>"Reset"</strong> to map the next building</li>
            </ol>
        </div>  

        <div class="map-container" id="mapContainer">
            <img src="capitol-complex.jpg" 
                 alt="Capitol Map" 
                 class="map-image" 
                 id="mapImage">
        </div>

        <div class="output-container">
            <div class="output-header">
                <h3>Output:</h3>
                <span class="status waiting" id="status">Waiting for clicks...</span>
            </div>

            <input type="text" 
                   class="building-name-input" 
                   id="buildingName" 
                   placeholder="Optional: Enter building name (e.g., Executive Building)">

            <div class="coordinate-list" id="coordList">
                <p style="color: #999; text-align: center;">Click on the map to start...</p>
            </div>

            <div class="final-output" id="finalOutput"></div>

            <div class="buttons">
                <button class="btn-copy" id="copyBtn" disabled>📋 Copy Coordinates</button>
                <button class="btn-reset" id="resetBtn">🔄 Reset / Next Building</button>
            </div>
        </div>
    </div>

    <div class="copy-notification" id="notification">
        ✅ Coordinates copied to clipboard!
    </div>

    <script>
        const mapImage = document.getElementById('mapImage');
        const mapContainer = document.getElementById('mapContainer');
        const coordList = document.getElementById('coordList');
        const finalOutput = document.getElementById('finalOutput');
        const status = document.getElementById('status');
        const copyBtn = document.getElementById('copyBtn');
        const resetBtn = document.getElementById('resetBtn');
        const notification = document.getElementById('notification');
        const buildingNameInput = document.getElementById('buildingName');

        let clicks = [];
        let markers = [];
        const ORIGINAL_WIDTH = 1050;  // Change if your image is different
        const ORIGINAL_HEIGHT = 1050;

        mapImage.addEventListener('click', function(e) {
            if (clicks.length >= 4) return;

            const rect = this.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            // Scale to original size
            const scaleX = ORIGINAL_WIDTH / rect.width;
            const scaleY = ORIGINAL_HEIGHT / rect.height;
            const originalX = Math.round(x * scaleX);
            const originalY = Math.round(y * scaleY);

            clicks.push({ x: originalX, y: originalY });

            // Add marker
            const marker = document.createElement('div');
            marker.className = 'marker';
            marker.style.left = x + 'px';
            marker.style.top = y + 'px';
            mapContainer.appendChild(marker);
            markers.push(marker);

            updateDisplay();
        });

        function updateDisplay() {
            const cornerNames = ['Top-Left', 'Top-Right', 'Bottom-Right', 'Bottom-Left'];
            
            coordList.innerHTML = '';
            clicks.forEach((coord, index) => {
                const div = document.createElement('div');
                div.className = 'coord-item';
                div.innerHTML = `<span class="coord-number">${cornerNames[index]}:</span> { x: ${coord.x}, y: ${coord.y} }`;
                coordList.appendChild(div);
            });

            // Update status
            if (clicks.length === 4) {
                status.className = 'status complete';
                status.textContent = '✅ Complete! Ready to copy';
                generateFinalOutput();
                copyBtn.disabled = false;
            } else {
                status.className = 'status active';
                status.textContent = `Click corner ${clicks.length + 1} of 4... (${cornerNames[clicks.length]})`;
            }
        }

        function generateFinalOutput() {
            const buildingName = buildingNameInput.value.trim() || 'your-building-id';
            const buildingId = buildingName.toLowerCase().replace(/\s+/g, '-');
            
            let output = `coordinates: [\n`;
            clicks.forEach(coord => {
                output += `    { "x": ${coord.x}, "y": ${coord.y} },\n`;
            });
            output += `]`;

            finalOutput.textContent = output;
            finalOutput.classList.add('show');
        }

        copyBtn.addEventListener('click', () => {
            const text = finalOutput.textContent;
            navigator.clipboard.writeText(text).then(() => {
                notification.classList.add('show');
                setTimeout(() => {
                    notification.classList.remove('show');
                }, 2000);
            });
        });

        resetBtn.addEventListener('click', () => {
            clicks = [];
            markers.forEach(m => m.remove());
            markers = [];
            coordList.innerHTML = '<p style="color: #999; text-align: center;">Click on the map to start...</p>';
            finalOutput.classList.remove('show');
            status.className = 'status waiting';
            status.textContent = 'Waiting for clicks...';
            copyBtn.disabled = true;
            buildingNameInput.value = '';
        });

        // Show image dimensions on load
        mapImage.addEventListener('load', () => {
            console.log('Map dimensions:', mapImage.naturalWidth, 'x', mapImage.naturalHeight);
            console.log('Using original dimensions:', ORIGINAL_WIDTH, 'x', ORIGINAL_HEIGHT);
            if (mapImage.naturalWidth !== ORIGINAL_WIDTH || mapImage.naturalHeight !== ORIGINAL_HEIGHT) {
                alert(`⚠️ Note: Your image is ${mapImage.naturalWidth}x${mapImage.naturalHeight}.\n\nUpdate ORIGINAL_WIDTH and ORIGINAL_HEIGHT in this file (lines 294-295) if coordinates don't match!`);
            }
        });
    </script>
</body>
</html>
