require('dotenv').config();
const express      = require('express');
const crypto       = require('crypto');
const bcrypt       = require('bcryptjs');
const router       = express.Router();
const activeTokens = require('../config/tokens');
const pool         = require('../config/database');

//Rate limiter — max 5 attempts per 15 minutes per IP 
const loginAttempts = new Map();

function checkRateLimit(ip) {
  const now     = Date.now();
  const attempts = loginAttempts.get(ip) || [];
  const recent  = attempts.filter(t => now - t < 15 * 60 * 1000);
  loginAttempts.set(ip, recent);
  return recent.length;
}

function recordAttempt(ip) {
  const attempts = loginAttempts.get(ip) || [];
  attempts.push(Date.now());
  loginAttempts.set(ip, attempts);
}

// Login route
router.post('/login', async (req, res) => {
  const ip = req.ip;

  // check rate limit first
  if (checkRateLimit(ip) >= 5) {
    return res.status(429).json({
      error: 'Too many login attempts. Try again in 15 minutes.'
    });
  }

  const { username, password } = req.body || {};

  if (!username || !password) {
    return res.status(400).json({ error: 'Missing credentials' });
  }

  try {
    const conn = await pool.getConnection();
    const [rows] = await conn.execute(
      'SELECT username, password_hash FROM admins WHERE username = ?',
      [username]
    );
    conn.release();

    if (rows.length === 0) {
      recordAttempt(ip);
      return res.status(401).json({ error: 'Invalid credentials' });
    }

    const admin = rows[0];
    const match = await bcrypt.compare(password, admin.password_hash);

    if (!match) {
      recordAttempt(ip);
      return res.status(401).json({ error: 'Invalid credentials' });
    }

    // success — generate token
    const token = crypto.randomBytes(32).toString('hex');
    activeTokens.set(token, username);
    
    // Auto-expire token in 8 hours
    setTimeout(() => activeTokens.delete(token), 8 * 60 * 60 * 1000);

    res.json({ token, username });

  } catch (error) {
    console.error('Login error:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

module.exports = router;
