function createImageSlider(images) {
  let current = 0;
  const wrap = document.createElement('div');
  wrap.className = 'image-slider-container';

  const strip = document.createElement('div');
  strip.className = 'slider-images';

  const counter = document.createElement('div');
  counter.className = 'image-counter';
  counter.textContent = `1 / ${images.length}`;

  const zoomIndicator = document.createElement('div');
  zoomIndicator.className = 'zoom-indicator';
  zoomIndicator.textContent = 'Tap image to enlarge';

  images.forEach((src, index) => {
    const img = document.createElement('img');
    img.className = 'slider-image';
    img.src = src;
    img.style.cursor = 'zoom-in';
    img.onerror = () => { 
      img.src = '/images/cagayan-logo.png';
      img.style.objectFit = 'contain';
      img.style.padding = '2rem';
      img.style.opacity = '0.5';
    };
    img.addEventListener('click', (e) => {
      e.stopPropagation();
      window.app.openLightbox(images, index);
    });
    strip.appendChild(img);
  });

  let swX = 0, swY = 0;
  strip.addEventListener('touchstart', (e) => {
    swX = e.touches[0].clientX;
    swY = e.touches[0].clientY;
  }, { passive: true });
  strip.addEventListener('touchend', (e) => {
    const dx = swX - e.changedTouches[0].clientX;
    const dy = Math.abs(swY - e.changedTouches[0].clientY);
    if (Math.abs(dx) > 50 && dy < 50) {
      goTo(dx > 0 ? (current + 1) % images.length : (current - 1 + images.length) % images.length);
    }
  }, { passive: true });

  const dotsWrap = document.createElement('div');
  dotsWrap.className = 'slider-nav';
  images.forEach((_, i) => {
    const dot = document.createElement('div');
    dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
    dot.onclick = () => goTo(i);
    dotsWrap.appendChild(dot);
  });

  const goTo = (index) => {
    current = index;
    strip.style.transform = `translateX(-${current * 100}%)`;
    dotsWrap.querySelectorAll('.slider-dot').forEach((d, i) => d.classList.toggle('active', i === current));
    counter.textContent = `${current + 1} / ${images.length}`;
  };

  const prev = document.createElement('button');
  prev.className = 'slider-arrow prev';
  prev.innerHTML = '&#8249;';
  prev.onclick = (e) => { e.stopPropagation(); goTo((current - 1 + images.length) % images.length); };

  const next = document.createElement('button');
  next.className = 'slider-arrow next';
  next.innerHTML = '&#8250;';
  next.onclick = (e) => { e.stopPropagation(); goTo((current + 1) % images.length); };

  wrap.append(strip, prev, next, dotsWrap, counter, zoomIndicator);
  return wrap;
}

function renderOffices(building) {
  const list = document.getElementById('officesList');
  if (!list) return;
  list.innerHTML = '';
  if (!building.floors || !Array.isArray(building.floors)) return;

  if (building.floors.length > 1) {
    const tabsWrap = document.createElement('div');
    tabsWrap.style.cssText = 'display:flex;gap:0.5rem;margin-bottom:1.5rem;flex-wrap:wrap;';
    building.floors.forEach((floor, i) => {
      const tab = document.createElement('button');
      tab.textContent = floor.name || `Floor ${floor.floor}`;
      tab.style.cssText = `
        padding:0.6rem 1.2rem; border-radius:20px;
        border:2px solid #003DA5;
        background:${i === 0 ? '#003DA5' : '#fff'};
        color:${i === 0 ? '#fff' : '#003DA5'};
        font-weight:600; font-size:0.9rem; cursor:pointer;
        transition:all 0.2s; touch-action:manipulation;
      `;
      tab.addEventListener('click', () => {
        tabsWrap.querySelectorAll('button').forEach(b => {
          b.style.background = '#fff';
          b.style.color = '#003DA5';
        });
        tab.style.background = '#003DA5';
        tab.style.color      = '#fff';
        const target = document.getElementById(`floor-section-${building.id}-${i}`);
        const panel  = document.getElementById('detailsPanel');
        if (target && panel) panel.scrollTo({ top: target.offsetTop - 20, behavior: 'smooth' });
      });
      tabsWrap.appendChild(tab);
    });
    list.appendChild(tabsWrap);
  }

  building.floors.forEach((floor, i) => {
    const section     = document.createElement('div');
    section.className  = 'floor-section';
    section.id         = `floor-section-${building.id}-${i}`;

    const header       = document.createElement('div');
    header.className    = 'floor-header';
    const floorLabel    = document.createElement('span');
    floorLabel.textContent = floor.name || `Floor ${floor.floor}`;
    const toggle        = document.createElement('span');
    toggle.className     = 'floor-toggle';
    toggle.textContent   = '▼';
    header.append(floorLabel, toggle);
    header.addEventListener('click', () => section.classList.toggle('collapsed'));

    const officesWrap     = document.createElement('div');
    officesWrap.className  = 'floor-offices';

    if (floor.offices && Array.isArray(floor.offices)) {
      floor.offices.forEach(office => {
        const item     = document.createElement('div');
        item.className  = 'office-item';

        const name     = document.createElement('div');
        name.className  = 'office-name';
        name.textContent = office.name || office;
        item.appendChild(name);

        if (office.direction) {
          const dirText = typeof office.direction === 'object'
            ? (office.direction.en || '')
            : (office.direction || '');

          const dir     = document.createElement('div');
          dir.className  = 'office-direction';
          dir.innerHTML  = `<i class="fas fa-map-signs" style="color:var(--primary-blue); margin-right:8px;"></i> ${dirText}`;
          item.appendChild(dir);

          const cta = document.createElement('div');
          cta.style.cssText = 'font-size:0.8rem;color:var(--primary-blue);font-weight:600;margin-top:0.4rem;opacity:0.7;padding-left:24px;';
          cta.textContent = 'Tap for more details';
          item.appendChild(cta);

          item.style.cursor = 'pointer';
          item.addEventListener('click', () => {
            window.app.showDirectionModal(office);
          });
        }

        // Add PDF Button if available
        if (office.pdf_url) {
          const pdfBtn = document.createElement('a');
          // Use path as-is from server (already starts with / if proxy)
          pdfBtn.href   = office.pdf_url;
          pdfBtn.target = '_blank';
          pdfBtn.className = 'pdf-view-btn';
          pdfBtn.innerHTML = '<i class="fas fa-file-pdf"></i> View Document';
          pdfBtn.style.cssText = `
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
            padding: 8px 16px;
            background: #eef2ff;
            color: #003DA5;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #d0d7de;
            transition: all 0.2s;
          `;
          pdfBtn.addEventListener('click', (e) => e.stopPropagation());
          item.appendChild(pdfBtn);
        }

        officesWrap.appendChild(item);
      });
    }

    section.append(header, officesWrap);
    list.appendChild(section);
  });
}
