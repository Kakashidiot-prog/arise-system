            background: #fff3cd;
            color: #856404;
        }

        .status.active {
            background: #d4edda;
            color: #155724;
            animation: blink 1s infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .status.complete {
            background: #d1ecf1;
            color: #0c5460;
        }

        .coordinate-list {
            background: white;
            padding: 20px;
            border-radius: 8px;
