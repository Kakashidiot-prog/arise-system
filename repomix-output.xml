    sub:'Week 7 · +6 EXP total',
    tasks:[
      {id:'m4t1',name:'Document model vs relational — why MongoDB',note:'Objects all the way down',exp:2},
      {id:'m4t2',name:'Mongoose schemas — types, required, defaults',note:'Define the shape of your data',exp:2},
      {id:'m4t3',name:'CRUD — find, findById, save, delete',note:'The five operations you\'ll use 90% of the time',exp:1},
      {id:'m4t4',name:'Connect Atlas + embed vs reference docs',note:'When to nest data vs separate collections',exp:1},
