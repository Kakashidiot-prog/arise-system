.floor-header:hover { background: linear-gradient(135deg, #0052CC, #0065FF); }

.floor-toggle { font-size: 1.5rem; transition: transform 0.3s; }
.floor-section.collapsed .floor-toggle { transform: rotate(-90deg); }

.floor-offices {
    padding: 1rem;
    max-height: none;
    overflow: visible;
    transition: max-height 0.3s ease;
}

.floor-section.collapsed .floor-offices {
    max-height: 0;
    padding: 0;
    overflow: hidden;
}

.office-item {
    padding: 1rem;
    background: #F8F9FA;
    border-left: 4px solid #003DA5;
    margin-bottom: 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s;
}

.office-item:hover {
    background: #E8F4F8;
    transform: translateX(5px);
    border-left-width: 6px;
}

.office-name { font-weight: 600; color: #003DA5; margin-bottom: 0.5rem; }

.office-direction {
    color: #666;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* Remove the emoji before */
.office-direction::before { content: ""; }

/* Building overlay */
.building-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
    transform-origin: 0 0;
    will-change: transform;
}

/* NAVIGATION STYLES */
.navigation-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
    transform-origin: 0 0;
}

.nav-directions-btn {
    animation: navSlideIn 0.3s ease;
}

@keyframes navSlideIn {
    from { transform: translateY(10px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}


.building-overlay polygon,
.building-overlay rect {
    pointer-events: all;
    cursor: pointer;
    transition: all 0.3s ease;
    fill-opacity: 0.15;
    fill: #4C9AFF;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 1;
}

.building-overlay polygon:hover,
.building-overlay rect:hover {
    fill-opacity: 0.5;
    fill: #4C9AFF;
    stroke: #FFFFFF;
    stroke-width: 3;
    filter: drop-shadow(0 4px 8px rgba(0, 61, 165, 0.3));
}

.building-overlay polygon.active,
.building-overlay rect.active {
    fill-opacity: 0.7;
    fill: #003DA5;
    stroke: #FFFFFF;
    stroke-width: 4;
}

.building-overlay polygon.highlighted,
.building-overlay rect.highlighted {
    fill-opacity: 0.7;
    fill: #003DA5;
    stroke: #FFFFFF;
    stroke-width: 3;
    animation: pulseGlow 1.5s ease-in-out infinite;
    filter: drop-shadow(0 4px 8px rgba(0, 61, 165, 0.3));
}

@keyframes pulseGlow {
    0%, 100% { fill-opacity: 0.6; stroke-width: 5; }
    50%       { fill-opacity: 0.8; stroke-width: 6; }
}

.hover-tooltip {
  position: fixed;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 215, 0, 0.4);
  border-radius: 12px;
  padding: 10px 16px;
  pointer-events: none;
  z-index: 500;
  opacity: 0;
  transition: opacity 0.2s ease;
  min-width: 160px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}

.hover-tooltip.visible {
  opacity: 1;
}

.tooltip-name {
  font-size: 14px;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4px;
}

.tooltip-hint {
  font-size: 11px;
  color: #FFD700;
  opacity: 0.8;
}

.hover-tooltip.visible { opacity: 1; }
.tooltip-name { font-weight: 600; margin-bottom: 0.25rem; }
.tooltip-hint { font-size: 0.8rem; opacity: 0.8; font-style: italic; }

/* INSTRUCTIONS */
.instructions {
    display: flex;
    justify-content: center;
    gap: 2rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, var(--primary-blue) 0%, var(--dark-blue) 100%);
    color: var(--white);
    flex-wrap: wrap;
}

.instruction-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; }
.instruction-icon { font-size: 1.3rem; }


.details-panel {
    position: fixed;
    top: 0;
    right: -620px;
    width: 600px;
    height: 100vh;
    background: var(--white);
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.3);
    transition: right var(--transition-slow);
    z-index: 1500;
    overflow-y: auto;
    will-change: right;
}

.details-panel.active { 
  right: 0;
  animation: panelSlideIn 0.3s ease-out;
}

@keyframes panelSlideIn {
  from { opacity: 0; transform: translateX(30px); }
  to   { opacity: 1; transform: translateX(0); }
}

.close-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 45px;
    height: 45px;
    background: var(--danger-red);
    color: var(--white);
    border: none;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
    z-index: 10;
    box-shadow: var(--shadow-md);
}

.close-btn:hover { background: var(--dark-gray); transform: rotate(90deg) scale(1.1); }

.details-content { padding: 2rem; padding-top: 5rem; }

.building-header { margin-bottom: 2rem; }

.building-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--primary-blue);
    color: var(--white);
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
}

.building-header h3 { color: var(--primary-blue); font-size: 2rem; margin-bottom: 0.5rem; }
.building-subtitle  { color: var(--medium-gray); font-size: 1.1rem; }

.building-image {
    width: 100%;
    height: 400px;
    background: var(--light-gray);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2rem;
    border: 3px solid var(--primary-blue);
    box-shadow: var(--shadow-md);
    position: relative;
}

.building-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

.building-image:hover img { transform: scale(1.05); }

.building-info h4 {
    color: var(--dark-blue);
    font-size: 1.3rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--primary-blue);
}

.building-area {
  fill: rgba(0, 61, 165, 0.3);
  stroke: rgba(0, 61, 165, 0.8);
  stroke-width: 2;
  cursor: pointer;
  transition: fill 0.2s ease, filter 0.2s ease;
}

.building-area:hover,
.building-area.highlighted {
  fill: rgba(255, 215, 0, 0.35);
  stroke: #FFD700;
  stroke-width: 2.5;
  filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.6));
}

.building-area.active {
  fill: rgba(255, 215, 0, 0.4);
  stroke: #FFD700;
  stroke-width: 3;
  filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.8));
}

.info-section { margin-bottom: 2.5rem; }
.info-section p { color: var(--dark-gray); line-height: 1.8; margin-bottom: 1.5rem; }

.info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
}

.info-card {
    background: var(--light-gray);
    padding: 1rem;
    border-radius: 8px;
    border-left: 4px solid var(--primary-blue);
}

.info-label { font-size: 0.85rem; color: var(--medium-gray); margin-bottom: 0.5rem; font-weight: 500; }
.info-value { font-size: 1.1rem; color: var(--primary-blue); font-weight: 600; }


#officesList {
    list-style: none;
    padding-right: 0.25rem;
}

/* FOOTER */
.footer {
    background: var(--black);
    color: var(--white);
    padding: 2rem;
    margin-top: 4rem;
}

.footer-content { max-width: 1600px; margin: 0 auto; text-align: center; }
.footer-content p { margin: 0.5rem 0; opacity: 0.9; }

/* GLOBAL HOME BUTTON */
.global-home-btn {
    position: fixed;
    bottom: 24px;
    right: 20px;
    z-index: 9999;
    background: #E74C3C;
    color: white;
    border: none;
    border-radius: 50px;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 6px 20px rgba(231, 76, 60, 0.4);
    transition: all 0.3s ease;
    min-height: 60px;
    min-width: 140px;
}

.global-home-btn:hover { background: #C0392B; transform: translateY(-3px); }
.global-home-btn i { font-size: 1.5rem; }

/* SCROLLBARS */
::-webkit-scrollbar       { width: 12px; }
::-webkit-scrollbar-track { background: var(--light-gray); }
::-webkit-scrollbar-thumb { background: var(--primary-blue); border-radius: 6px; }
::-webkit-scrollbar-thumb:hover { background: var(--dark-blue); }

/* ACCESSIBILITY */
.visually-hidden {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0, 0, 0, 0); border: 0;
}

button:focus-visible,
input:focus-visible {
    outline: 3px solid var(--warning-orange);
    outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* RESPONSIVE */
@media (max-width: 1200px) {
    .header-content { flex-direction: column; text-align: center; }
    .header-right   { text-align: center; }
    .details-panel  { width: 500px; right: -520px; }
}

@media (max-width: 1080px) {
    .header          { padding: 0.75rem 1.5rem; }
    .seal            { width: 55px; height: 55px; }
    .title-section h1{ font-size: 1.2rem; }
    .title-section h2{ font-size: 0.85rem; }
    .datetime        { font-size: 0.85rem; }
}

@media (max-width: 768px) {
    .main-content      { padding: 1rem; }
    .title-section h1  { font-size: 1.3rem; }
    .search-container  { flex-wrap: wrap; border-radius: 12px; }
    .search-btn        { width: 100%; border-radius: 8px; }
    .quick-access      { gap: 0.5rem; }
    .filter-btn        { font-size: 0.85rem; padding: 0.6rem 1rem; }
    .details-panel     { width: 100%; right: -100%; }
    .instructions      { flex-direction: column; gap: 1rem; }
    .global-home-btn   { bottom: 16px; right: 10px; padding: 0.75rem 1.5rem; }
}

@media (max-width: 480px) {
    .header           { padding: 1rem; }
    .seal             { width: 60px; height: 60px; }
    .title-section h1 { font-size: 1.1rem; }
    .logo-section     { flex-direction: column; gap: 0.75rem; }
    .map-header       { flex-direction: column; gap: 1rem; }
    .info-grid        { grid-template-columns: 1fr; }
}

/* ── Navigation Instruction Card (MallNav Style) ── */
.nav-instruction-card {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(150%);
    width: 340px;
    max-width: calc(100vw - 40px);
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 20px;
    border: 1px solid rgba(255, 215, 0, 0.3);
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.2);
    z-index: 1000;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.nav-instruction-card.active {
    transform: translateX(-50%) translateY(0);
}

.nav-card-header {
    background: linear-gradient(135deg, #003DA5, #002366);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
}

.nav-icon {
    font-size: 1.2rem;
    color: #FFD700;
}

.nav-title {
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    flex: 1;
}

.nav-close-btn {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
}

.nav-close-btn:hover {
    background: rgba(231, 76, 60, 0.8);
}

.nav-card-body {
    padding: 18px 20px;
}

.nav-direction-label, .nav-next-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #7F8C8D;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.nav-direction-text {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1a2744;
    margin-bottom: 12px;
    line-height: 1.2;
}

.nav-next-text {
    font-size: 0.95rem;
    font-weight: 600;
    color: #003DA5;
}

.nav-card-footer {
    padding: 0 20px 20px;
}

.nav-confirm-btn {
    width: 100%;
    background: #003DA5;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 14px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 15px rgba(0, 61, 165, 0.3);
    transition: all 0.2s;
}

.nav-confirm-btn:hover {
    background: #002366;
    transform: translateY(-2px);
}

.nav-confirm-btn:active {
    transform: translateY(0);
}

.nav-confirm-btn.reached {
    background: #27AE60;
}

/* ── Active Path Segment ── */
.nav-active-segment {
    stroke: var(--primary-blue);
    stroke-width: 8;
    filter: url(#nav-glow);
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 1;
}

.nav-dimmed-path {
    stroke: var(--primary-blue);
    stroke-width: 4;
    opacity: 0.25;
    stroke-dasharray: 8, 6;
}

@media (max-width: 480px) {
    .nav-instruction-card {
        bottom: 20px;
        width: calc(100vw - 30px);
    }
}
