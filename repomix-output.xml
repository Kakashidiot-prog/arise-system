document.getElementById('floors-container').addEventListener('click', e => {
  const btn = e.target.closest('[data-action]');
  if (btn) {
    e.stopPropagation();
    const { action, id, fid } = btn.dataset;
    if (action === 'add-o')  { _expandedFloorId = fid; openOfficeModal(fid); }
    if (action === 'edit-f') openFloorModal(_fMap[id]);
    if (action === 'del-f')  confirmDelete('floor',  id, `Floor ${_fMap[id]?.floor_number ?? id}`);
    if (action === 'edit-o') { _expandedFloorId = fid; openOfficeModal(fid, _oMap[id]); }
    if (action === 'del-o')  { 
      const office = _oMap[id];
      if (office) _expandedFloorId = office._floorId;
      confirmDelete('office', id, office?.name || id); 
    }
    return;
  }
  const head = e.target.closest('[data-toggle]');
  if (head) {
    const fid = head.dataset.fid;
    const body = head.nextElementSibling;
    const isOpening = body.style.display === 'none';
    body.style.display = isOpening ? 'block' : 'none';
    _expandedFloorId = isOpening ? fid : null;
  }
});

