  .tag { display: inline-block; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 600; font-family: var(--font-mono); letter-spacing: 0.3px; }
  .tag-blue   { background: rgba(79,142,255,.15);  color: var(--accent); }
