const fs = require('fs').promises;
const mysql = require('mysql2/promise');
const ftp = require('basic-ftp');
const { Readable } = require('stream');
const path = require('path');
require('dotenv').config();

/**
 * PGC-FIS PDF Splitter (FTP Direct Version)
 * Splits the main PDF and uploads parts directly to FTP.
 * No local files are saved to keep the system light.
 */

const inputFile = 'PGCagayan.pdf';

const dbConfig = {
  host:     process.env.DB_HOST,
  port:     process.env.DB_PORT,
  user:     process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  database: process.env.DB_NAME,
};

const ftpConfig = {
  host: process.env.FTP_HOST,
  user: process.env.FTP_USER,
  password: process.env.FTP_PASS,
  secure: false
};

const offices = [
  { name: "Provincial Administrator's Office", startPage: 45 },
  { name: "Internal Audit Unit (IAU)", startPage: 33 },
  { name: "Information System Division (ISD)", startPage: 36 },
  { name: "Governor's Office (GO)", startPage: 14 },
  { name: "(PESO)", startPage: 100 },
  { name: "PPDO Main Office", startPage: 141 },
  { name: "Provincial Budget Office (PBO)", startPage: 145 },
  { name: "HR Office", startPage: 117 },
  { name: "Cagayan Provincial Information Office (CPIO)", startPage: 62 },
  { name: "Provincial Assessor's Office (PA)", startPage: 212 },
  { name: "Provincial Treasury Office", startPage: 204 },
  { name: "Accounting Office", startPage: 161 },
  { name: "Provincial Legal Office (PLO)", startPage: 68 },
  { name: "Tourism Office", startPage: 82 },
  { name: "Office of the SECRETARY  to the SANGGUNIAN PANLALAWIGAN (SP)", startPage: 312 },
  { name: "Office of the Vice Governor", startPage: 310 },
  { name: "PDRRMO Main Office", startPage: 50 },
  { name: "Provincial Engineer's Office (PEO)", startPage: 288 },
  { name: "Procurement Back Office", startPage: 390 },
  { name: "Property and Supply Office", startPage: 400 },
  { name: "PSWDO Main Office", startPage: 243 },
  { name: "Medical Services", startPage: 317 },
  { name: "Provincial Natural Resources and Environment Office (PNREO)", startPage: 276 },
];

async function runAutoSplitAndLink() {
  let connection;
  const client = new ftp.Client();

  try {
    // 1. Check if master PDF exists
    try { await fs.access(inputFile); } catch {
      console.error(`\n❌ Error: "${inputFile}" not found in root directory.`);
      return;
    }

    // 2. Connect to Database and FTP
    connection = await mysql.createConnection(dbConfig);
    console.log("🔗 Connected to database.");

    await client.access(ftpConfig);
    // Path where the proxy expects split PDFs
    const remoteDir = `${process.env.FTP_BASE_PATH || '/fis'}/pdf/splits`;
    await client.ensureDir(remoteDir);
    console.log(`✅ FTP Connected. Remote directory: ${remoteDir}`);

    // 3. Load master PDF
    console.log(`📄 Loading ${inputFile}...`);
    const existingPdfBytes = await fs.readFile(inputFile);
    const pdfDoc = await PDFDocument.load(existingPdfBytes);
    const totalPages = pdfDoc.getPageCount();

    offices.sort((a, b) => a.startPage - b.startPage);

    console.log(`✂️ Splitting and Uploading ${offices.length} offices...\n`);

    for (let i = 0; i < offices.length; i++) {
      const office = offices[i];
      const endPage = (i + 1 < offices.length) ? offices[i + 1].startPage - 1 : totalPages;

      if (office.startPage > totalPages) continue;

      const newPdfDoc = await PDFDocument.create();
      const pageIndices = [];
      for (let p = office.startPage - 1; p < endPage; p++) {
        if (p < totalPages) pageIndices.push(p);
      }

      if (pageIndices.length === 0) continue;

      const copiedPages = await newPdfDoc.copyPages(pdfDoc, pageIndices);
      copiedPages.forEach((page) => newPdfDoc.addPage(page));

      const safeName = office.name.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase().replace(/_+/g, '_');
      const filename = `${safeName}_charter.pdf`;
      const newPdfBytes = await newPdfDoc.save();

      // 4. Upload bytes directly to FTP via stream
      const stream = new Readable();
      stream.push(newPdfBytes);
      stream.push(null); // End of stream
      await client.uploadFrom(stream, filename);

      // 5. Update DB with the virtual path for the proxy
      const virtualPath = `images/citizen_charter_splits/${filename}`;
      const [result] = await connection.execute(
        "UPDATE offices SET pdf_url = ? WHERE name = ?",
        [virtualPath, office.name]
      );

      if (result.affectedRows > 0) {
        console.log(`✅ [UPLOADED] ${office.name}`);
      } else {
        console.warn(`⚠️ [NOT FOUND] "${office.name}" in database.`);
      }
    }

    console.log(`\n🎉 Process Complete! All files are stored on FTP and linked.`);
  } catch (error) {
    console.error("\n❌ Error:", error.message);
  } finally {
    client.close();
    if (connection) await connection.end();
  }
}

runAutoSplitAndLink();
