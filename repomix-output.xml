    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-muted);
    pointer-events: none;
    backdrop-filter: blur(4px);
  }

  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  .legend {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-line {
    width: 24px;
    height: 3px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .instructions-box {
    background: rgba(255,215,0,.05);
    border: 1px solid rgba(255,215,0,.15);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .instructions-box strong { color: var(--accent); }
</style>
</head>
<body>

<header>
  <div class="logo">PGC<span>.</span>FIS</div>
  <div class="header-title">Navigation Path Editor</div>
  <div class="header-actions">
    <button class="btn btn-ghost btn-sm" onclick="clearAll()"><i class="fas fa-trash"></i> Clear All</button>
    <button class="btn btn-blue btn-sm" onclick="loadFromFIS()"><i class="fas fa-download"></i> Load From System</button>
    <button class="btn btn-green btn-sm" onclick="generateOutput()"><i class="fas fa-code"></i> Generate JSON</button>
    <button class="btn btn-primary btn-sm" onclick="copyOutput()"><i class="fas fa-copy"></i> Copy JSON</button>
    <button class="btn btn-green btn-sm" onclick="saveToSystem()"><i class="fas fa-save"></i> Save to System</button>
  </div>
</header>

<div class="workspace">

  <!-- SIDEBAR -->
  <div class="sidebar">

    <!-- MODE -->
    <div class="sidebar-section">
      <h3>Edit Mode</h3>
      <div class="mode-grid">
        <button class="mode-btn active" id="mode-node" onclick="setMode('node')">
          <span class="mode-icon"><i class="fas fa-map-marker-alt"></i></span>
          Add Node
        </button>
        <button class="mode-btn" id="mode-edge" onclick="setMode('edge')">
          <span class="mode-icon"><i class="fas fa-route"></i></span>
          Add Path
        </button>
        <button class="mode-btn" id="mode-select" onclick="setMode('select')">
          <span class="mode-icon"><i class="fas fa-mouse-pointer"></i></span>
          Select
        </button>
        <button class="mode-btn" id="mode-delete" onclick="setMode('delete')">
          <span class="mode-icon"><i class="fas fa-trash-alt"></i></span>
          Delete
        </button>
      </div>
    </div>

    <!-- NODE SETTINGS -->
    <div class="sidebar-section" id="node-settings">
      <h3>Node Settings</h3>
      <div class="form-group">
        <label>Node Name</label>
        <input class="form-control" id="node-name" placeholder="e.g. Main Gate" value="Node" oninput="updateNodeFromUI()">
      </div>
      <div class="form-group">
        <label>Node Type</label>
        <div class="node-type-grid">
          <button class="type-btn active" data-type="junction" onclick="setNodeType('junction')"><i class="fas fa-circle-notch"></i><br>Junction</button>
          <button class="type-btn" data-type="road" onclick="setNodeType('road')"><i class="far fa-dot-circle"></i><br>Road Point</button>
          <button class="type-btn" data-type="building" onclick="setNodeType('building')"><i class="fas fa-building"></i><br>Building</button>
          <button class="type-btn" data-type="entrance" onclick="setNodeType('entrance')"><i class="fas fa-door-open"></i><br>Entrance</button>
          <button class="type-btn" data-type="kiosk" onclick="setNodeType('kiosk')"><i class="fas fa-desktop"></i><br>Kiosk</button>
          <button class="type-btn" data-type="gate" onclick="setNodeType('gate')"><i class="fas fa-torii-gate"></i><br>Gate</button>
          <button class="type-btn" data-type="parking" onclick="setNodeType('parking')"><i class="fas fa-parking"></i><br>Parking</button>
        </div>
      </div>
      <div class="form-group">
        <label>Building ID (optional)</label>
        <select class="form-control" id="node-building-id">
          <option value="">— None —</option>
        </select>
      </div>

      <!-- Kiosk Assignment -->
      <div style="display:flex;gap:6px;margin-top:6px;">
        <button class="btn btn-sm" style="flex:1;background:rgba(255,215,0,.1);color:var(--accent);border:1px solid rgba(255,215,0,.3);" onclick="setAsKiosk(1)">
          <i class="fas fa-desktop"></i> Set Kiosk 1
        </button>
        <button class="btn btn-sm" style="flex:1;background:rgba(34,211,160,.1);color:var(--green);border:1px solid rgba(34,211,160,.3);" onclick="setAsKiosk(2)">
          <i class="fas fa-desktop"></i> Set Kiosk 2
        </button>
      </div>
      <div style="display:flex;gap:6px;margin-top:6px;">
        <button class="btn btn-sm" style="flex:1;background:rgba(0,61,165,0.1);color:#4f8eff;border:1px solid rgba(0,61,165,0.3);" onclick="setAsKiosk(3)">
          <i class="fas fa-desktop"></i> Set Kiosk 3
        </button>
      </div>
    </div>

    <!-- LEGEND -->
    <div class="legend">
      <h3 style="font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:var(--text-muted);margin-bottom:10px;">Legend</h3>
      <div class="legend-item"><div class="legend-dot" style="background:#FFD700;"></div> Junction / Intersection</div>
      <div class="legend-item"><div class="legend-dot" style="background:#FFFFFF; width: 8px; height: 8px;"></div> Road Point (Curve Waypoint)</div>
      <div class="legend-item"><div class="legend-dot" style="background:#003DA5;"></div> Building Entrance</div>
      <div class="legend-item"><div class="legend-dot" style="background:#22d3a0;"></div> Gate / Entry Point</div>
      <div class="legend-item"><div class="legend-dot" style="background:#f5a623;"></div> Kiosk Location</div>
      <div class="legend-item"><div class="legend-dot" style="background:#ff4f6a;"></div> Parking</div>
      <div class="legend-item"><div class="legend-line" style="background:#4f8eff;"></div> Walking Path</div>
    </div>

    <!-- TABS: Nodes / Edges -->
    <div class="tabs">
      <button class="tab active" onclick="switchTab('nodes')">Nodes (<span id="node-count">0</span>)</button>
      <button class="tab" onclick="switchTab('edges')">Paths (<span id="edge-count">0</span>)</button>
      <button class="tab" onclick="switchTab('kiosks')">Kiosks</button>
    </div>

    <div class="list-area">
      <!-- Nodes tab -->
      <div class="tab-content active" id="tab-nodes">
        <div id="nodes-list"><div class="empty-msg">No nodes yet.<br>Click on the map to add.</div></div>
      </div>

      <!-- Edges tab -->
      <div class="tab-content" id="tab-edges">
        <div id="edges-list"><div class="empty-msg">No paths yet.<br>Switch to "Add Path" mode.</div></div>
      </div>

      <!-- Kiosks tab -->
      <div class="tab-content" id="tab-kiosks">
        <div style="padding:12px;">
          <div style="margin-bottom:12px;">
            <div style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">Kiosk 1</div>
            <div id="kiosk1-status" style="font-size:12px;color:var(--text-muted);">Not set</div>
          </div>
          <div style="margin-bottom:12px;">
            <div style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">Kiosk 2</div>
            <div id="kiosk2-status" style="font-size:12px;color:var(--text-muted);">Not set</div>
          </div>
          <div style="margin-bottom:12px;">
            <div style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">Kiosk 3</div>
            <div id="kiosk3-status" style="font-size:12px;color:var(--text-muted);">Not set</div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- MAP AREA -->
  <div class="map-area">
    <div id="map-canvas-wrapper">

      <!-- Map image — replace src with your actual map -->
      <img id="map-img" src="/images/capitol-complex.jpg" alt="Capitol Complex Map"
        onerror="this.style.background='#1a1e28';this.style.opacity='0.3';">

      <!-- SVG overlay for nodes and edges -->
      <svg id="nav-svg" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Animated dash for paths -->
          <marker id="arrowhead" markerWidth="6" markerHeight="4" refX="6" refY="2" orient="auto">
            <polygon points="0 0, 6 2, 0 4" fill="#4f8eff" opacity="0.8"/>
          </marker>
        </defs>
        <g id="edges-g"></g>
        <g id="nodes-g"></g>
        <!-- Edge preview line while drawing -->
        <line id="edge-preview" x1="0" y1="0" x2="0" y2="0"
          stroke="#FFD700" stroke-width="2" stroke-dasharray="6,4" opacity="0" pointer-events="none"/>
      </svg>

      <!-- Coords display -->
      <div class="coords-display" id="coords-display">x: 0, y: 0</div>

    </div>

    <!-- Status bar -->
    <div class="statusbar" id="statusbar">
      Mode: <span class="accent">Add Node</span> — Click on map to place a node
    </div>

    <!-- Output panel -->
    <div class="output-panel" id="output-panel">
      <div class="output-header">
        <span>navigation.json</span>
        <button class="btn btn-sm btn-ghost" onclick="document.getElementById('output-panel').classList.remove('show')">✕</button>
      </div>
      <div class="output-code" id="output-code"></div>
    </div>

  </div>
</div>

<div class="notif" id="notif"></div>

<script>
// ── STATE ──────────────────────────────────────────────────────
const state = {
  nodes: [],      // { id, name, type, x, y, buildingId }
  edges: [],      // { id, from, to }
  mode: 'node',
  nodeType: 'junction',
  selectedNode: null,
  edgeStart: null,
  kiosk1: null,   // node id
  kiosk2: null,   // node id
  kiosk3: null,   // node id
  imgW: 1050,     // REFERENCE SIZE (Matching app.js)
  imgH: 1050,
  counter: 0,
  buildings: {}   // Added for dropdown
};

// ── BUILDINGS FETCH ────────────────────────────────────────────
async function loadBuildings() {
  try {
    const res = await fetch('/api/buildings?t=' + Date.now());
    const data = await res.json();
    state.buildings = data.buildings || {};
    
    const select = document.getElementById('node-building-id');
    select.innerHTML = '<option value="">— None —</option>';
    
    Object.keys(state.buildings).sort((a,b) => 
      state.buildings[a].name.localeCompare(state.buildings[b].name)
    ).forEach(id => {
      const opt = document.createElement('option');
      opt.value = id;
      opt.textContent = state.buildings[id].name;
      select.appendChild(opt);
    });

    // Add change listener to automatically update node name when building is selected
    select.onchange = () => {
      const buildingId = select.value;
      if (buildingId && state.buildings[buildingId]) {
        document.getElementById('node-name').value = state.buildings[buildingId].name;
        setNodeType('entrance'); // Buildings usually use entrance nodes
        updateNodeFromUI();
      }
    };

    console.log('✅ Buildings loaded for dropdown');
  } catch (e) {
    console.error('❌ Failed to load buildings:', e);
  }
}

// ── PERSISTENCE ────────────────────────────────────────────────
function saveToLocal() {
  localStorage.setItem('pgc_nav_backup', JSON.stringify({
    nodes: state.nodes,
    edges: state.edges,
    kiosks: { k1: state.kiosk1, k2: state.kiosk2, k3: state.kiosk3 },
    counter: state.counter
  }));
}

function loadFromLocal() {
  const data = localStorage.getItem('pgc_nav_backup');
  if (data) {
    const parsed = JSON.parse(data);
    state.nodes = parsed.nodes || [];
    state.edges = parsed.edges || [];
    state.kiosk1 = parsed.kiosks?.k1 || null;
    state.kiosk2 = parsed.kiosks?.k2 || null;
    state.kiosk3 = parsed.kiosks?.k3 || null;
    state.counter = parsed.counter || 0;
    refreshDisplay();
    showNotif('✅ Progress restored from local storage');
  }
}

async function loadFromFIS() {
  if (!confirm('Load currently used navigation data from the system? This will replace your local changes.')) return;
  try {
    const res = await fetch('/api/navigation?t=' + Date.now());
    if (!res.ok) throw new Error('File not found.');
    const data = await res.json();
    
    state.nodes = data.nodes || [];
    state.edges = data.edges || [];
    state.kiosk1 = data.kiosks?.kiosk1 || null;
    state.kiosk2 = data.kiosks?.kiosk2 || null;
    state.kiosk3 = data.kiosks?.kiosk3 || null;
    
    let max = 0;
    state.nodes.forEach(n => {
      const match = n.id.match(/node_(\d+)_/);
      if (match) max = Math.max(max, parseInt(match[1]));
    });
    state.counter = max;

    refreshDisplay();
    showNotif('✅ Loaded layout currently in use by FIS');
  } catch (e) {
    alert('Error loading navigation data.');
  }
}

function refreshDisplay() {
  nodesG.innerHTML = '';
  edgesG.innerHTML = '';
  state.edges.forEach(e => renderEdge(e));
  state.nodes.forEach(n => {
    const sv = mapToSvg(n.x, n.y);
    renderNode(n, sv.x, sv.y);
  });
  updateNodesList();
  updateEdgesList();
  updateCounts();
  updateKioskStatus();
}

// ── NODE COLORS ────────────────────────────────────────────────
const NODE_COLORS = {
  junction: '#FFD700',
  road:     '#FFFFFF',
  building: '#003DA5',
  entrance: '#4f8eff',
  kiosk:    '#f5a623',
  gate:     '#22d3a0',
  parking:  '#ff4f6a'
};

const NODE_RADIUS = {
  junction: 6,
  road:     3,
  building: 8,
  entrance: 7,
  kiosk:    9,
  gate:     8,
  parking:  6
};

// ── INIT ───────────────────────────────────────────────────────
const wrapper   = document.getElementById('map-canvas-wrapper');
const svg       = document.getElementById('nav-svg');
const nodesG    = document.getElementById('nodes-g');
const edgesG    = document.getElementById('edges-g');
const preview   = document.getElementById('edge-preview');
const coordDisp = document.getElementById('coords-display');
const mapImg    = document.getElementById('map-img');

function getMapCoords(e) {
  const rect = mapImg.getBoundingClientRect();
  const imgW = 1050; 
  const imgH = 1050;
  const px = e.clientX - rect.left;
  const py = e.clientY - rect.top;
  const mx = Math.round((px / rect.width) * imgW);
  const my = Math.round((py / rect.height) * imgH);
  return { mapX: Math.max(0, Math.min(imgW, mx)), mapY: Math.max(0, Math.min(imgH, my)), svgX: px, svgY: py };
}

function mapToSvg(mx, my) {
  const rect = mapImg.getBoundingClientRect();
  return { x: (mx / 1050) * rect.width, y: (my / 1050) * rect.height };
}

wrapper.addEventListener('mousemove', (e) => {
  const { mapX, mapY, svgX, svgY } = getMapCoords(e);
  coordDisp.textContent = `x: ${mapX},  y: ${mapY}`;
  if (state.mode === 'edge' && state.edgeStart) {
    preview.setAttribute('x2', svgX);
    preview.setAttribute('y2', svgY);
    preview.setAttribute('opacity', '0.7');
  }
});

wrapper.addEventListener('mouseleave', () => { preview.setAttribute('opacity', '0'); });

wrapper.addEventListener('click', (e) => {
  if (e.target.closest('.nav-node')) return; 
  const { mapX, mapY, svgX, svgY } = getMapCoords(e);
  if (state.mode === 'node') addNode(mapX, mapY, svgX, svgY);
  else if (state.mode === 'edge' && state.edgeStart) {
    state.edgeStart = null;
    preview.setAttribute('opacity', '0');
    updateStatus();
  }
});

function addNode(mapX, mapY, svgX, svgY) {
  state.counter++;
  const name       = document.getElementById('node-name').value.trim() || `Node ${state.counter}`;
  const buildingId = document.getElementById('node-building-id').value.trim();
  const id         = `node_${state.counter}_${name.toLowerCase().replace(/\s+/g,'_').replace(/[^a-z0-9_]/g,'')}`;
  const node = { id, name, type: state.nodeType, x: mapX, y: mapY, buildingId: buildingId || null };
  state.nodes.push(node);
  renderNode(node, svgX, svgY);
  updateNodesList();
  updateCounts();
  saveToLocal();
  showNotif(`📍 Node added: ${name}`);
}

function renderNode(node, svgX, svgY) {
  const color  = NODE_COLORS[node.type]  || '#FFD700';
  const radius = NODE_RADIUS[node.type]  || 6;
  const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  g.setAttribute('class', 'nav-node');
  g.setAttribute('data-id', node.id);
  const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  circle.setAttribute('cx', svgX); circle.setAttribute('cy', svgY); circle.setAttribute('r', radius);
  circle.setAttribute('fill', color); circle.setAttribute('stroke', '#0a0c10'); circle.setAttribute('stroke-width', '2');
  const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
  label.setAttribute('x', svgX); label.setAttribute('y', svgY - radius - 4);
  label.setAttribute('text-anchor', 'middle'); label.setAttribute('fill', '#e8eaf0');
  label.setAttribute('font-size', '10'); label.setAttribute('font-family', 'DM Sans, sans-serif');
  label.setAttribute('paint-order', 'stroke'); label.setAttribute('stroke', '#0a0c10'); label.setAttribute('stroke-width', '3');
  label.textContent = node.name;
  g.appendChild(circle); g.appendChild(label); nodesG.appendChild(g);
  g.addEventListener('click', (e) => { e.stopPropagation(); handleNodeClick(node.id, e); });
  g.addEventListener('contextmenu', (e) => { e.preventDefault(); selectNode(node.id); });
}

function handleNodeClick(nodeId, e) {
  if (state.mode === 'select') selectNode(nodeId);
  else if (state.mode === 'delete') deleteNode(nodeId);
  else if (state.mode === 'edge') {
    if (!state.edgeStart) {
      state.edgeStart = nodeId;
      const svgPos = getNodeSvgPos(nodeId);
      preview.setAttribute('x1', svgPos.x); preview.setAttribute('y1', svgPos.y);
      preview.setAttribute('x2', svgPos.x); preview.setAttribute('y2', svgPos.y);
      preview.setAttribute('opacity', '0.7');
      updateStatus();
      showNotif(`〰️ Path started from: ${getNode(nodeId).name}`);
    } else {
      if (state.edgeStart === nodeId) {
        state.edgeStart = null; preview.setAttribute('opacity', '0'); updateStatus(); return;
      }
      addEdge(state.edgeStart, nodeId); state.edgeStart = null; preview.setAttribute('opacity', '0'); updateStatus();
    }
  } else if (state.mode === 'node') selectNode(nodeId);
}

function addEdge(fromId, toId) {
  const exists = state.edges.find(e => (e.from === fromId && e.to === toId) || (e.from === toId && e.to === fromId));
  if (exists) { showNotif('⚠️ Path already exists'); return; }
  const id = `edge_${fromId}_${toId}`;
  const edge = { id, from: fromId, to: toId };
  state.edges.push(edge);
  renderEdge(edge); updateEdgesList(); updateCounts(); saveToLocal();
  showNotif(`〰️ Path added`);
}

function renderEdge(edge) {
  const fromNode = getNode(edge.from); const toNode = getNode(edge.to);
  if (!fromNode || !toNode) return;
  const fp = mapToSvg(fromNode.x, fromNode.y); const tp = mapToSvg(toNode.x, toNode.y);
  const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  line.setAttribute('x1', fp.x); line.setAttribute('y1', fp.y); line.setAttribute('x2', tp.x); line.setAttribute('y2', tp.y);
  line.setAttribute('stroke', '#4f8eff'); line.setAttribute('stroke-width', '2.5'); line.setAttribute('stroke-dasharray', '8,4');
  line.setAttribute('opacity', '0.75'); line.setAttribute('data-edge-id', edge.id); line.setAttribute('marker-end', 'url(#arrowhead)');
  line.addEventListener('click', () => { if (state.mode === 'delete') deleteEdge(edge.id); });
  edgesG.appendChild(line);
}

function getNode(id) { return state.nodes.find(n => n.id === id); }
function getNodeEl(id) { return nodesG.querySelector(`[data-id="${id}"]`); }
function getNodeSvgPos(id) {
  const el = getNodeEl(id); if (!el) return { x: 0, y: 0 };
  const circle = el.querySelector('circle');
  return { x: parseFloat(circle.getAttribute('cx')), y: parseFloat(circle.getAttribute('cy')) };
}

function selectNode(id) {
  nodesG.querySelectorAll('.nav-node').forEach(el => el.classList.remove('selected'));
  state.selectedNode = id; const el = getNodeEl(id); if (el) el.classList.add('selected');
  const node = getNode(id);
  if (node) {
    document.getElementById('node-name').value = node.name;
    document.getElementById('node-building-id').value = node.buildingId || '';
    setNodeType(node.type);
  }
}

function deleteNode(id) {
  state.edges = state.edges.filter(e => {
    if (e.from === id || e.to === id) { edgesG.querySelector(`[data-edge-id="${e.id}"]`)?.remove(); return false; }
    return true;
  });
  state.nodes = state.nodes.filter(n => n.id !== id); getNodeEl(id)?.remove();
  if (state.kiosk1 === id) state.kiosk1 = null; if (state.kiosk2 === id) state.kiosk2 = null; if (state.kiosk3 === id) state.kiosk3 = null;
  updateNodesList(); updateEdgesList(); updateCounts(); updateKioskStatus(); saveToLocal();
}

function deleteEdge(id) {
  state.edges = state.edges.filter(e => e.id !== id); edgesG.querySelector(`[data-edge-id="${id}"]`)?.remove();
  updateEdgesList(); updateCounts(); saveToLocal();
}

function setAsKiosk(num) {
  if (!state.selectedNode) {
    showNotif('⚠️ Select a node on the map first!');
    return;
  }
  
  // 1. Assign the ID
  if (num === 1) state.kiosk1 = state.selectedNode;
  if (num === 2) state.kiosk2 = state.selectedNode;
  if (num === 3) state.kiosk3 = state.selectedNode;
  
  // 2. Automatically change the node type to 'kiosk' so it turns orange
  const node = getNode(state.selectedNode);
  if (node) {
    node.type = 'kiosk';
    refreshDisplay(); // Redraw the map to show the orange dot
  }
  
  updateKioskStatus();
  saveToLocal();
  showNotif(`📺 Assigned as Kiosk ${num}`);
}

function updateKioskStatus() {
  const k1 = document.getElementById('kiosk1-status'); const k2 = document.getElementById('kiosk2-status'); const k3 = document.getElementById('kiosk3-status');
  if (k1) k1.textContent = state.kiosk1 ? getNode(state.kiosk1)?.name : 'Not set';
  if (k2) k2.textContent = state.kiosk2 ? getNode(state.kiosk2)?.name : 'Not set';
  if (k3) k3.textContent = state.kiosk3 ? getNode(state.kiosk3)?.name : 'Not set';
}

function updateNodeFromUI() {
  if (!state.selectedNode) return;
  const node = getNode(state.selectedNode);
  if (!node) return;
  node.name = document.getElementById('node-name').value;
  node.buildingId = document.getElementById('node-building-id').value || null;
  refreshDisplay();
  updateNodesList();
  updateKioskStatus();
  saveToLocal();
}

function setMode(mode) {
  state.mode = mode; state.edgeStart = null; preview.setAttribute('opacity', '0');
  document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(`mode-${mode}`)?.classList.add('active');
  document.getElementById('node-settings').style.display = mode === 'node' ? 'block' : 'none';
  updateStatus();
}

function setNodeType(type) {
  state.nodeType = type; 
  document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
  const btn = document.querySelector(`[data-type="${type}"]`);
  if (btn) btn.classList.add('active');
  
  if (state.selectedNode) {
    const node = getNode(state.selectedNode);
    if (node) {
      node.type = type;
      refreshDisplay();
      saveToLocal();
    }
  }
}

function updateStatus() {
  const sb = document.getElementById('statusbar');
  const msgs = { node: 'Mode: <span class="accent">Add Node</span>', edge: state.edgeStart ? 'Mode: <span class="accent">Add Path</span> — Select target' : 'Mode: <span class="accent">Add Path</span> — Select start', select: 'Mode: <span class="accent">Select</span>', delete: 'Mode: <span class="accent">Delete</span>' };
  sb.innerHTML = msgs[state.mode];
}

function updateNodesList() {
  const list = document.getElementById('nodes-list');
  if (!state.nodes.length) { list.innerHTML = '<div class="empty-msg">No nodes</div>'; return; }
  list.innerHTML = state.nodes.map(n => `<div class="list-item ${state.selectedNode === n.id ? 'selected' : ''}" onclick="selectNode('${n.id}')"><div class="dot" style="background:${NODE_COLORS[n.type]}"></div><span class="item-name">${n.name}</span><button class="del-btn" onclick="event.stopPropagation();deleteNode('${n.id}')">✕</button></div>`).join('');
}

function updateEdgesList() {
  const list = document.getElementById('edges-list');
  if (!state.edges.length) { list.innerHTML = '<div class="empty-msg">No paths</div>'; return; }
  list.innerHTML = state.edges.map(e => `<div class="list-item"><span class="item-name">${getNode(e.from)?.name} → ${getNode(e.to)?.name}</span><button class="del-btn" onclick="deleteEdge('${e.id}')">✕</button></div>`).join('');
}

function updateCounts() { document.getElementById('node-count').textContent = state.nodes.length; document.getElementById('edge-count').textContent = state.edges.length; }

function switchTab(name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.getAttribute('onclick').includes(name)));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.toggle('active', c.id === `tab-${name}`));
}

function generateOutput() {
  const output = { kiosks: { kiosk1: state.kiosk1, kiosk2: state.kiosk2, kiosk3: state.kiosk3 }, nodes: state.nodes, edges: state.edges.map(e => ({ from: e.from, to: e.to, weight: calcWeight(e.from, e.to) })) };
  const json = JSON.stringify(output, null, 2); document.getElementById('output-code').textContent = json;
  document.getElementById('output-panel').classList.add('show'); return json;
}

function calcWeight(fromId, toId) {
  const a = getNode(fromId), b = getNode(toId);
  return a && b ? Math.round(Math.sqrt((a.x - b.x) ** 2 + (a.y - b.y) ** 2)) : 0;
}

function copyOutput() { navigator.clipboard.writeText(generateOutput()).then(() => showNotif('✅ Copied!')); }

async function saveToSystem() {
  const token = sessionStorage.getItem('admin_token');
  if (!token) {
    alert('❌ Error: No Admin Token found. Please log in through the Admin Dashboard first.');
    return;
  }

  const data = JSON.parse(generateOutput());
  if(!confirm('Apply these changes to the LIVE system? This will affect all Kiosks.')) return;

  try {
    const res = await fetch('/api/admin/navigation', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json', 
        'Authorization': `Bearer ${token}` 
      },
      body: JSON.stringify(data)
    });

    if(res.ok) {
      alert('✅ Navigation system updated successfully!');
      showNotif('✅ Saved to server');
    } else if (res.status === 401) {
      alert('❌ Session expired. Please log in again on the Admin page.');
    } else {
      alert('❌ Server Error: Failed to save navigation data.');
    }
  } catch (e) {
    alert('❌ Connection Error: ' + e.message);
  }
}

function clearAll() { if (!confirm('Clear all?')) return; state.nodes = []; state.edges = []; state.counter = 0; localStorage.removeItem('pgc_nav_backup'); refreshDisplay(); }

let notifTimer;
function showNotif(msg) { const el = document.getElementById('notif'); el.textContent = msg; el.classList.add('show'); clearTimeout(notifTimer); notifTimer = setTimeout(() => el.classList.remove('show'), 2500); }

async function loadActiveMap() {
  const mapImg = document.getElementById('map-img');
  if (!mapImg) return;

  // Default is already set in HTML, we only override if a valid setting exists
  try {
    const res = await fetch('/api/settings');
    if (!res.ok) return;
    const data = await res.json();
    const path = data.settings?.active_map;
    if (path) {
      const filename = path.split(/[\/\\]/).pop();
      // Only override if it's actually a different file
      if (filename && filename !== 'capitol-complex.jpg' && filename !== 'capitol-complex.jpeg') {
        mapImg.src = `/api/view/${filename}`;
      }
    }
  } catch (e) {
    // Fail silently: keep hardcoded map
  }
}

window.addEventListener('resize', refreshDisplay);
window.addEventListener('load', () => {
  loadActiveMap();
  loadFromLocal();
  loadBuildings();
});

document.addEventListener('keydown', (e) => {
  if (e.target.tagName === 'INPUT') return;
  if (e.key === 'n') setMode('node'); if (e.key === 'p') setMode('edge'); if (e.key === 's') setMode('select'); if (e.key === 'd') setMode('delete');
});
</script>
</body>
</html>
