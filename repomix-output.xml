<body>

<header>
  <div class="logo">PGC<span>.</span>FIS</div>
  <div style="font-size:13px;color:#6b7280;border-left:1px solid #252a38;padding-left:12px;">Navigation Preview</div>

  <button class="btn-kiosk active" id="kiosk1-btn" onclick="setKiosk('kiosk1')">
    📺 Kiosk 1 (Guard House)
  </button>
  <button class="btn-kiosk" id="kiosk2-btn" onclick="setKiosk('kiosk2')">
    📺 Kiosk 2 (Capitol)
  </button>

  <select id="building-select" onchange="navigate()">
    <option value="">— Select destination building —</option>
  </select>

  <button class="btn-nav" onclick="navigate()">🗺️ Navigate</button>
  <button class="btn-clear" onclick="clearNav()">✕ Clear</button>

  <div class="status" id="status-text">Ready</div>
</header>

<div class="map-container">
  <div id="mapWrapper">
    <img id="siteMap" src="../public/images/capitol-complex.jpg"
      onerror="document.getElementById('status-text').textContent='Map image not found — check path'"
      onload="document.getElementById('status-text').textContent='Map loaded ✅'; drawAllNodes();">
    <svg id="buildingOverlay"></svg>
  </div>

  <div class="info-panel" id="info-panel" style="display:none">
    <h4>Path Steps</h4>
    <div id="path-steps"></div>
  </div>
</div>

<script>
const ORIG_W = 1050, ORIG_H = 1050;
let navData  = null;
let activeKiosk = 'kiosk1';

// ── GET ACTUAL IMAGE BOUNDS ──
function getMapBounds() {
  const map = document.getElementById('siteMap');
  if (!map || !map.complete) return null;

  const containerW = map.offsetWidth;
  const containerH = map.offsetHeight;
  const imgW = map.naturalWidth;
  const imgH = map.naturalHeight;

  const scale = Math.min(containerW / imgW, containerH / imgH);
  const renderedW = imgW * scale;
  const renderedH = imgH * scale;

  // Offset if object-position is top left
  const offsetX = 0; 
  const offsetY = 0;

  return { renderedW, renderedH, offsetX, offsetY };
}

function toSvg(node) {
  const bounds = getMapBounds();
  if (!bounds) return { x: 0, y: 0 };
  return {
    x: bounds.offsetX + (node.x / ORIG_W) * bounds.renderedW,
    y: bounds.offsetY + (node.y / ORIG_H) * bounds.renderedH
  };
}

// ── LOAD NAV DATA ──
function loadData() {
  // Try public folder path
  fetch('../public/navigation.json?t=' + Date.now())
    .then(r => {
      if (!r.ok) throw new Error("File not found");
      return r.json();
    })
    .then(data => {
      navData = data;
      document.getElementById('status-text').textContent =
        `Navigation loaded — ${data.nodes.length} nodes, ${data.edges.length} edges`;
      drawAllNodes();
    })
    .catch(e => {
      // Fallback to local if running without server
      fetch('navigation.json?t=' + Date.now())
        .then(r => r.json())
        .then(data => {
          navData = data;
          document.getElementById('status-text').textContent =
            `Navigation loaded (local) — ${data.nodes.length} nodes`;
          drawAllNodes();
        })
        .catch(err => {
          document.getElementById('status-text').textContent = '❌ navigation.json not found';
        });
    });
}

// ── BUILDINGS LIST ────────────────────
const BUILDINGS = [
  { id: 'executive-main',          name: 'Executive Main Buildings' },
  { id: 'commissary',              name: 'Commissary and Canteen' },
  { id: 'vice-governor-office',    name: 'Office of the Vice Governor' },
  { id: 'legislative-building',    name: 'Legislative Building' },
  { id: 'finance-building',        name: 'Finance Building' },
  { id: 'pswdo-building',          name: 'PSWDO Building' },
  { id: 'provincial-clinic',       name: 'Provincial Clinic / PHO' },
  { id: 'peo-new-building',        name: "Provincial Engineer's Office (PEO)" },
  { id: 'motor-pool',              name: 'Motor Pool' },
  { id: 'gso-new-building',        name: 'GSO New Building' },
  { id: 'peo-warehouse',           name: 'PEO Warehouse' },
  { id: 'ppdo-building',           name: 'PPDO Building' },
  { id: 'kammaranan-hall',         name: 'Kammaranan Hall' },
  { id: 'gasat-hall',              name: 'Gasat Hall' },
  { id: 'hrmo-building',           name: 'HRMO Building' },
  { id: 'gymnasium',               name: 'Capitol Gymnasium' },
  { id: 'pope-guest-house',        name: 'POPE Guest House' },
  { id: 'pdrrmo',                  name: 'PDRRMO' },
  { id: 'gso-warehouse',           name: 'GSO Warehouse' },
  { id: 'tflc-building',           name: 'TFLC Building' },
  { id: 'tflc-warehouse',          name: 'TFLC Warehouse' },
  { id: 'child-development-center','name': 'Child Development Center' },
  { id: 'warehouse',               name: 'Warehouse' },
];

// Populate Dropdown
const sel = document.getElementById('building-select');
BUILDINGS.sort((a,b) => a.name.localeCompare(b.name)).forEach(b => {
  const o = document.createElement('option');
  o.value = b.id; o.textContent = b.name;
  sel.appendChild(o);
});

// ── DIJKSTRA ──
function findPath(startId, endId, nodes, edges) {
  const graph = {};
  nodes.forEach(n => { graph[n.id] = []; });
  edges.forEach(e => {
    if (graph[e.from] && graph[e.to]) {
      graph[e.from].push({ id: e.to,   w: e.weight });
      graph[e.to].push({   id: e.from, w: e.weight });
    }
  });

  const dist = {}, prev = {}, visited = new Set();
  nodes.forEach(n => { dist[n.id] = Infinity; prev[n.id] = null; });
  dist[startId] = 0;
  const queue = [{ id: startId, d: 0 }];

  while (queue.length) {
    queue.sort((a,b) => a.d - b.d);
    const cur = queue.shift();
    if (visited.has(cur.id)) continue;
    visited.add(cur.id);
    if (cur.id === endId) break;
    for (const nb of (graph[cur.id] || [])) {
      if (visited.has(nb.id)) continue;
      const nd = dist[cur.id] + nb.w;
      if (nd < dist[nb.id]) {
        dist[nb.id] = nd;
        prev[nb.id] = cur.id;
        queue.push({ id: nb.id, d: nd });
      }
    }
  }
  if (dist[endId] === Infinity) return null;
  const path = []; let u = endId;
  while (u) { path.unshift(u); u = prev[u]; }
  return path;
}

function drawAllNodes() {
  const svg = document.getElementById('buildingOverlay');
  if (!navData) return;
  const bounds = getMapBounds();
  if (!bounds) return;

  svg.setAttribute('viewBox', `0 0 ${bounds.renderedW} ${bounds.renderedH}`);
  svg.style.width  = bounds.renderedW  + 'px';
  svg.style.height = bounds.renderedH + 'px';
  svg.innerHTML = '';

  navData.nodes.forEach(n => {
    const p = toSvg(n);
    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('cx', p.x); c.setAttribute('cy', p.y); c.setAttribute('r', '3');
    c.setAttribute('fill', 'rgba(255,215,0,0.5)');
    svg.appendChild(c);
  });
}

function navigate() {
  const buildingId = document.getElementById('building-select').value;
  if (!buildingId || !navData) return;

  const dest = navData.nodes.find(n => n.buildingId === buildingId);
  if (!dest) { 
    document.getElementById('status-text').textContent = `⚠️ No node for: ${buildingId}`;
    return; 
  }

  const startId = navData.kiosks[activeKiosk];
  const path = findPath(startId, dest.id, navData.nodes, navData.edges);

  if (!path) { 
    document.getElementById('status-text').textContent = `❌ No path found to ${dest.name}`;
    return; 
  }

  // Draw Line
  const svg = document.getElementById('buildingOverlay');
  svg.querySelectorAll('.nav-line').forEach(l => l.remove());
  
  let d = "";
  path.forEach((id, i) => {
    const n = navData.nodes.find(node => node.id === id);
    const p = toSvg(n);
    d += (i === 0 ? "M" : "L") + p.x + "," + p.y;
  });

  const line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
  line.setAttribute('d', d);
  line.setAttribute('stroke', '#FFD700');
  line.setAttribute('stroke-width', '4');
  line.setAttribute('fill', 'none');
  line.setAttribute('class', 'nav-line');
  line.style.filter = "drop-shadow(0 0 5px rgba(255,215,0,0.8))";
  svg.appendChild(line);

  document.getElementById('status-text').textContent = `✅ Path shown: ${path.length} nodes`;
}

function clearNav() {
  const svg = document.getElementById('buildingOverlay');
  svg.querySelectorAll('.nav-line').forEach(l => l.remove());
  document.getElementById('building-select').value = '';
  document.getElementById('status-text').textContent = 'Cleared';
}

function setKiosk(k) {
  activeKiosk = k;
  document.querySelectorAll('.btn-kiosk').forEach(b => b.classList.remove('active'));
  document.getElementById(k + '-btn').classList.add('active');
  document.getElementById('status-text').textContent = `Kiosk set to: ${k}`;
  clearNav();
}

window.onload = loadData;
window.onresize = drawAllNodes;
</script>
</body>
</html>
