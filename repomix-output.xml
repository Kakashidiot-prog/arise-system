class FacilitiesInfoSystem {
  constructor() {
    this.buildingsData           = {};
    this.searchIndex             = [];
    this.currentBuilding         = null;
    this.highlightedBuilding     = null;
    this.activeFilter            = 'all';
    this.tappedBuilding          = null;
    this.originalMapWidth        = 1050;
    this.originalMapHeight       = 1050;
    this._searchResultJustTapped = false;
    this._tappedBuildingTimer    = null;
  }

  async loadData() {
    try {
      const response = await fetch(`/api/buildings?t=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error('Failed to load buildings data');
      const data = await response.json();
      this.buildingsData = data.buildings;
      this.validateData();
      this.buildSearchIndex();
      console.log(` Loaded ${Object.keys(this.buildingsData).length} buildings`);
      return true;
    } catch (error) {
      console.error(' Data loading error:', error);
      // show user-friendly message
      const overlay = document.getElementById('loadingOverlay');
      if (overlay) {
        overlay.innerHTML = `
      <div style="text-align:center;color:white;">
        <div style="font-size:3rem;margin-bottom:1rem;">[!]</div>
        <p style="font-size:1.2rem;font-weight:600;">Unable to load map data</p>
        <p style="opacity:0.8;margin-top:0.5rem;">Please check your connection and refresh</p>
        <button onclick="location.reload()" style="margin-top:1.5rem;padding:0.75rem 2rem;
          background:#FFD700;color:#003DA5;border:none;border-radius:25px;
          font-weight:700;cursor:pointer;font-size:1rem;">
          Retry
        </button>
      </div>`;
      }
      return false;
    }
  }

  validateData() {
    const validCategories = ['administrative', 'services', 'facilities'];
    Object.entries(this.buildingsData).forEach(([key, building]) => {
      if (!building.id)   console.warn(`${key}: Missing ID`);
      if (!building.name) console.warn(`${key}: Missing name`);
      if (!validCategories.includes(building.category))
        console.warn(`${key}: Invalid category "${building.category}"`);
      if (!building.coordinates || building.coordinates.length < 3)
        console.warn(`${key}: Invalid coordinates`);
    }); 
  }

  buildSearchIndex() {
    this.searchIndex = [];
    Object.values(this.buildingsData).forEach(building => {
      this.searchIndex.push({
        type: 'building', name: building.name,
        buildingId: building.id,
        searchText: building.name.toLowerCase(),
        category:   building.category
      });
      if (building.floors && Array.isArray(building.floors)) {
        building.floors.forEach(floor => {
          if (floor.offices && Array.isArray(floor.offices)) {
            floor.offices.forEach(office => {
              if (office.name) {
                this.searchIndex.push({
                  type: 'office', name: office.name,
                  buildingId:   building.id,
                  buildingName: building.name,
                  searchText:   office.name.toLowerCase(),
                  category:     building.category
                });
              }
            });
          }
        });
      }
    });
  }

  async loadActiveMap() {
    const siteMap = document.getElementById('siteMap');
    if (!siteMap) return;

    // Default map is already set in HTML, we only try to override if possible
    try {
      const res = await fetch('/api/settings');
      if (!res.ok) return; 
      
      const data = await res.json();
      const path = data.settings?.active_map;
      
      if (path) {
        const filename = path.split(/[\/\\]/).pop();
        // Only override if it's actually a different file
        if (filename && filename !== 'capitol-complex.jpg' && filename !== 'capitol-complex.jpeg') {
          siteMap.src = `/api/view/${filename}`;
        }
      }
    } catch (e) {
      // Fallback: stay on the working hardcoded map
    }
  }

  async init() {
    await this.loadActiveMap();
    const loaded = await this.loadData();
    if (!loaded) return;

    setupDateTime();
    setupSearch();
    setupFilters();
    this.setupDetailsPanelControls();
    this.setupResetButton();
    this.setupClickOutsideToClose();
    setupIdleReset();
    this.setupPanelSwipeToClose();
    setupGlobalHomeButton();
    setupMapPinchZoom();
    
    if (window.navSystem) {
      await window.navSystem.init();
    }

    const siteMap = document.getElementById('siteMap');
    if (!siteMap) return;

    if (siteMap.complete && siteMap.naturalWidth > 0) {
      drawBuildingOverlays();
      this.hideLoading();
    } else {
      siteMap.addEventListener('load', () => { drawBuildingOverlays(); this.hideLoading(); });
      setTimeout(() => { drawBuildingOverlays(); this.hideLoading(); }, 1500);
    }

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => drawBuildingOverlays(), 250);
    });

    setTimeout(() => location.reload(), 86400000);

    // Auto-refresh building data every 3 minutes
    setInterval(async () => {
      const ok = await this.loadData();
      if (ok && !this.currentBuilding) {
        drawBuildingOverlays();
      }
    }, 30 * 1000);
  }
  
  hideLoading() {
    const overlay = document.getElementById('loadingOverlay');
    if (overlay) {
      overlay.style.opacity = '0';
      setTimeout(() => { if (overlay.parentNode) overlay.style.display = 'none'; }, 400);
    }
  }

  showTooltip(building, event) {
    const tip = document.getElementById('hoverTooltip');
    if (!tip) return;
    const nameEl = tip.querySelector('.tooltip-name');
    if (nameEl) nameEl.textContent = building.name;
    this.moveTooltip(event);
    tip.classList.add('visible');
  }

  moveTooltip(event) {
    const tip = document.getElementById('hoverTooltip');
    if (!tip) return;
    const tipRect = tip.getBoundingClientRect();
    let left = event.clientX + 20, top = event.clientY + 20;
    if (left + tipRect.width  > window.innerWidth)  left = event.clientX - tipRect.width  - 20;
    if (top  + tipRect.height > window.innerHeight) top  = event.clientY - tipRect.height - 20;
    if (left < 0) left = 20;
    if (top  < 0) top  = 20;
    tip.style.left = left + 'px';
    tip.style.top  = top  + 'px';
  }

  hideTooltip() {
    const tip = document.getElementById('hoverTooltip');
    if (tip) tip.classList.remove('visible');
  }

  highlightBuilding(buildingId) {
    this.clearHighlights();
    const poly = document.querySelector(`polygon[data-building-id="${buildingId}"]`);
    if (poly) { poly.classList.add('highlighted'); this.highlightedBuilding = buildingId; }
  }

  clearHighlights() {
    document.querySelectorAll('.building-area.highlighted').forEach(el => el.classList.remove('highlighted'));
    this.highlightedBuilding = null;
  }

  clearActiveStates() {
    document.querySelectorAll('.building-area.active').forEach(el => el.classList.remove('active'));
  }

  setupResetButton() {
    const btn = document.getElementById('resetView');
    if (btn) {
      btn.addEventListener('click', () => {
        this.clearHighlights();
        this.closeDetailsPanel(false); // Stop navigation on reset
        this.tappedBuilding = null;
        if (window.navSystem) window.navSystem.stopNavigation();
        if (this._mapZoomReset) this._mapZoomReset();
      });
    }
  }

  setupDetailsPanelControls() {
    const closeBtn = document.getElementById('closeBtn');
    const panel    = document.getElementById('detailsPanel');
    if (closeBtn) closeBtn.addEventListener('click', () => this.closeDetailsPanel(true));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel && panel.classList.contains('active')) this.closeDetailsPanel(true);
    });
  }

  setupClickOutsideToClose() {
    document.addEventListener('click', (e) => {
      if (this._searchResultJustTapped) return;
      const panel = document.getElementById('detailsPanel');
      if (!panel || !panel.classList.contains('active')) return;
      if (!panel.contains(e.target) && !e.target.closest('.building-area')) {
        this.closeDetailsPanel(true);
        this.tappedBuilding = null;
      }
    });
  }

  setupPanelSwipeToClose() {
    const panel = document.getElementById('detailsPanel');
    if (!panel) return;
    let startX = 0, startY = 0, dragging = false;

    panel.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      dragging = false;
    }, { passive: true });

    panel.addEventListener('touchmove', (e) => {
      const dx = e.touches[0].clientX - startX;
      const dy = Math.abs(e.touches[0].clientY - startY);
      if (dx > 10 && dy < 60) {
        dragging = true;
        panel.style.transform  = `translateX(${Math.min(dx, 300)}px)`;
        panel.style.transition = 'none';
      }
    }, { passive: true });

    panel.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = Math.abs(e.changedTouches[0].clientY - startY);
      panel.style.transition = '';
      panel.style.transform  = '';
      if (dragging && dx > 80 && dy < 60) this.closeDetailsPanel(true);
      dragging = false;
    }, { passive: true });
  }

  closeDetailsPanel(keepNavigation = true) {
    const panel = document.getElementById('detailsPanel');
    if (panel) {
      panel.classList.remove('active');
      panel.style.transform  = '';
      panel.style.transition = '';
    }
    const imgContainer = document.querySelector('.building-image');
    if (imgContainer) imgContainer.innerHTML = '';
    this.clearActiveStates();
    this.clearHighlights();
    this.currentBuilding = null;
    this.tappedBuilding = null;
    
    // Only stop navigation if explicitly requested (false)
    if (!keepNavigation) {
      window.navSystem?.stopNavigation();
    }
  }

