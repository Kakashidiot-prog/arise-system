  .form-control:focus { border-color: var(--accent); }
  textarea.form-control { resize: vertical; min-height: 80px; }
  select.form-control { cursor: pointer; }

  .floor-block { background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 12px; overflow: hidden; }
  .floor-block-head { padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
