        }

        .map-image {
            width: 100%;
            height: auto;
            display: block;
            cursor: crosshair;
        }

        .marker {
            position: absolute;
            width: 20px;
            height: 20px;
            background: red;
            border: 3px solid white;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
            animation: pulse 1s infinite;
            pointer-events: none;
        }

        @keyframes pulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.2); }
        }

        .output-container {
            background: #f5f5f5;
            border: 2px solid #ddd;
            border-radius: 8px;
