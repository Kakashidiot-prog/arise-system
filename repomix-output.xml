const express = require('express');
const router  = express.Router();
const pool    = require('../config/database');
const ftp     = require('basic-ftp');
const fs      = require('fs');
const path    = require('path');

// Caching logic for buildings data
let cachedBuildings = null;
let cacheTime       = null;
const CACHE_TTL     = 30 * 1000;

function fixPath(p) {
  if (!p) return null;
  if (p.startsWith('http')) return p; 
  const filename = p.split('/').pop();
  return `/api/view/${filename}`;
}

function getMimeType(filename) {
  const ext = path.extname(filename).toLowerCase();
  const map = {
    '.pdf': 'application/pdf', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg',
    '.png': 'image/png', '.gif': 'image/gif', '.svg': 'image/svg+xml', '.webp': 'image/webp'
  };
  return map[ext] || 'application/octet-stream';
}

/**
 * SMART PROXY with Auto-Caching
 */
router.get('/view/:filename', async (req, res) => {
  const { filename } = req.params;
  const isPdf = filename.toLowerCase().endsWith('.pdf');
  const mimeType = getMimeType(filename);

  //  FAST TRACK: Check local storage first 
  const localFolders = [
    '../../public/images',
    '../../public/images/temp',
    '../../public/pgc-images',
    '../../public/images/citizen_charter_splits'
  ];

  for (const f of localFolders) {
    const fullPath = path.resolve(__dirname, f, filename);
    if (fs.existsSync(fullPath)) {
      return res.sendFile(fullPath);
    }
  }

  //  SLOW TRACK: If not local, get from FTP and CACHE it
  console.log(` [FTP Proxy]: Searching for ${filename}...`);
  const client = new ftp.Client();
  client.ftp.verbose = false; // Set to true if you need to see raw FTP commands

  try {
    await client.access({
      host:     process.env.FTP_HOST,
      user:     process.env.FTP_USER,
      password: process.env.FTP_PASS,
      secure:   false
    });

    const basePath = (process.env.FTP_BASE_PATH || '/fis').replace(/\/$/, '');

    // Exact folders seen in your FileZilla log
    const folders = isPdf 
      ? [`${basePath}/pdf`, `${basePath}/pdf/citizen_charter_splits`, `${basePath}/pdf/splits`]
      : [
          `${basePath}/pix`, 
          `${basePath}/pix/pgc-images`, 
          `${basePath}/pix/1`, 
          `${basePath}/pix/2`, 
          `${basePath}/images`
        ];

    for (const folder of folders) {
      const remotePath = `${folder}/${filename}`;
      try {
       
        const size = await client.size(remotePath).catch(() => -1);

        if (size >= 0) {
          console.log(`✅ [FTP]: Found ${filename} in ${folder}. Downloading...`);
          const saveDir = path.resolve(__dirname, '../../public/images/temp');
          if (!fs.existsSync(saveDir)) fs.mkdirSync(saveDir, { recursive: true });
          const savePath = path.join(saveDir, filename);

          //  Download to local cache first
          await client.downloadTo(savePath, remotePath);
          client.close();

          //  Serve the local file with correct headers
          res.setHeader('Content-Type', mimeType);
          res.setHeader('Cache-Control', 'public, max-age=86400');
          return res.sendFile(savePath);
        }
      } catch (e) {
        
      }
    }
    console.log(` [FTP Proxy]: ${filename} not found in any FTP folder.`);
  } catch (err) {
    console.error(` [FTP Proxy Error]:`, err.message);
  } finally {
    client.close();
  }
  res.status(404).send("Not found");
});

router.get('/buildings', async (req, res) => {
  try {
    if (cachedBuildings && (Date.now() - cacheTime) < CACHE_TTL) {
      return res.json({ buildings: cachedBuildings });
    }
    const conn = await pool.getConnection();  
    const [buildings] = await conn.execute("SELECT * FROM buildings ORDER BY name");
    const buildingsData = {};

    for (const b of buildings) {
      const [imgs]   = await conn.execute("SELECT image_path FROM building_images WHERE building_id = ?", [b.id]);
      const [coords] = await conn.execute("SELECT x, y FROM coordinates WHERE building_id = ? ORDER BY point_order", [b.id]);
      const [floors] = await conn.execute("SELECT * FROM floors WHERE building_id = ? ORDER BY floor_number", [b.id]);

      const floorsData = [];
      for (const f of floors) {
        const [offs] = await conn.execute("SELECT * FROM offices WHERE floor_id = ?", [f.id]);
        floorsData.push({
          floor: f.floor_number, name: f.name,
          offices: offs.map(o => ({ ...o, photo: fixPath(o.photo), pdf_url: fixPath(o.pdf_url) }))
        });
      }
      buildingsData[b.id] = { ...b, operatingHours: b.operating_hours, images: imgs.map(i => fixPath(i.image_path)), coordinates: coords, floors: floorsData };
    }
    cachedBuildings = buildingsData; cacheTime = Date.now();
    conn.release();
    res.json({ buildings: buildingsData });
  } catch (e) { res.status(500).json({ error: 'DB Error' }); }
});

router.get('/navigation', (req, res) => {
  try {
    const data = fs.readFileSync(path.join(__dirname, '../../public/navigation.json'), 'utf8');
    res.json(JSON.parse(data));
  } catch (e) { res.json({ kiosks: {}, nodes: [], edges: [] }); }
});

router.get('/settings', async (req, res) => {
  try {
    const conn = await pool.getConnection();
    const [rows] = await conn.execute('SELECT setting_key, setting_value FROM settings');
    conn.release();
    const settings = {};
    rows.forEach(row => { settings[row.setting_key] = row.setting_value; });
    res.json({ settings });
  } catch (e) {
    res.status(500).json({ error: 'DB Error' });
  }
});

const invalidateCache = () => {
  cachedBuildings = null;
  cacheTime = null;
};

module.exports = {
  router,
  invalidateCache
};
</file>

