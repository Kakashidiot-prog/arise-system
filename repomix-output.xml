      {id:'m5t2',name:'bcrypt — never store plain passwords',note:'Hash before save, compare on login',exp:1},
      {id:'m5t3',name:'Auth middleware — protect routes',note:'The gatekeeper between requests and data',exp:1},
      {id:'m5t4',name:'CORS + axios interceptors frontend',note:'Connect React to your real backend',exp:1},
      {id:'m5t5',name:'Deploy — Render + Vercel + Atlas',note:'Your app live on the internet. Ship it.',exp:1},
    ]
  }
];

const DEFAULT_BODY=[
  {
    id:'b1',name:'Daily Grind — Bodyweight',icon:'💪',
    sub:'Every day · +1 EXP per session',
    tasks:[
      {id:'b1t1',name:'Push-ups — 3 sets',note:'Start: 3×10. Progress to 3×20',exp:0.25},
      {id:'b1t2',name:'Squats — 3 sets',note:'Bodyweight. Add weight when 3×20 feels easy',exp:0.25},
      {id:'b1t3',name:'Plank — hold 60s',note:'Build to 2 min. Core is everything',exp:0.25},
      {id:'b1t4',name:'Pull-ups or inverted rows — 3 sets',note:'Doorframe bar or table rows if no bar',exp:0.25},
    ]
  },
  {
    id:'b2',name:'Cardio Gate',icon:'🏃',
    sub:'3× per week · +0.5 EXP per run',
    tasks:[
      {id:'b2t1',name:'30 min run or brisk walk',note:'Zone 2 cardio — can hold a conversation pace',exp:0.5},
      {id:'b2t2',name:'10 min HIIT finisher',note:'20s work / 10s rest × 8 rounds. Burpees, jumping jacks',exp:0.25},
      {id:'b2t3',name:'Stretch & cool down — 10 min',note:'Hip flexors, hamstrings, shoulders',exp:0.25},
    ]
  },
  {
    id:'b3',name:'Hunter Diet Protocol',icon:'🥗',
    sub:'Daily habits · +0.5 EXP per day',
    tasks:[
      {id:'b3t1',name:'Drink 2–3L water',note:'Set an alarm every 2 hrs if you forget',exp:0.25},
      {id:'b3t2',name:'Eat protein with every meal',note:'Egg, chicken, tofu, legumes — aim for 0.8g/kg bodyweight',exp:0.25},
    ]
  },
  {
    id:'b4',name:'Recovery Arc',icon:'😴',
    sub:'Non-negotiable · +0.5 EXP per day',
    tasks:[
      {id:'b4t1',name:'Sleep 7–8 hours',note:'Muscle is built during sleep, not the gym',exp:0.25},
      {id:'b4t2',name:'No phone 30 min before bed',note:'Blue light kills melatonin. Try it for a week.',exp:0.25},
    ]
  }
];

// ── STATE ──
let state=loadState();

function loadState(){
  try{
    const s=localStorage.getItem('sl_tracker');
    if(s) return JSON.parse(s);
  }catch(e){}
  return {
    checked:{},
    customTasks:{},
    log:[],
    streak:0,
    lastActiveDate:null,
    weekActivity:{}
  };
}
function saveState(){
  try{ localStorage.setItem('sl_tracker',JSON.stringify(state)); }catch(e){}
}

// ── EXP / LEVEL ──
function getTotalExp(){
  let total=0;
  const allQuests=[...DEFAULT_MIND,...DEFAULT_BODY];
  allQuests.forEach(q=>{
    const tasks=[...q.tasks,...(state.customTasks[q.id]||[])];
    tasks.forEach(t=>{ if(state.checked[t.id]) total+=t.exp; });
  });
  return Math.round(total*10)/10;
}
function getLevel(exp){ return Math.floor(exp/5)+1; }
function getRank(exp){
  let r=RANKS[0];
  for(const entry of RANKS){ if(exp>=entry[0]) r=entry; }
  return r;
}

// ── STREAK ──
function updateStreak(){
  const today=new Date().toISOString().slice(0,10);
  if(state.lastActiveDate===today) return;
  const yesterday=new Date(Date.now()-86400000).toISOString().slice(0,10);
  if(state.lastActiveDate===yesterday){ state.streak=(state.streak||0)+1; }
  else if(state.lastActiveDate!==today){ state.streak=1; }
  state.lastActiveDate=today;
  state.weekActivity[today]=true;
  saveState();
}

// ── RENDER STATS ──
function renderStats(){
  const exp=getTotalExp();
  const lvl=getLevel(exp);
  const rank=getRank(exp);
  const expInLevel=exp%5;
  const pct=Math.round((expInLevel/5)*100);

  document.getElementById('stat-level').textContent=lvl;
  document.getElementById('stat-exp').textContent=exp;
  document.getElementById('rank-label').textContent=rank[1]+' · Level '+lvl;

  const allQuests=[...DEFAULT_MIND,...DEFAULT_BODY];
  let done=0,total=0;
  allQuests.forEach(q=>{
    const tasks=[...q.tasks,...(state.customTasks[q.id]||[])];
    tasks.forEach(t=>{ total++; if(state.checked[t.id]) done++; });
  });
  document.getElementById('stat-quests').textContent=done+'/'+total;
  document.getElementById('stat-streak').textContent=state.streak||0;
  document.getElementById('exp-bar').style.width=pct+'%';
  document.getElementById('exp-pct').textContent=expInLevel.toFixed(1)+' / 5';
}

// ── RENDER QUESTS ──
function renderQuests(quests,containerId){
  const el=document.getElementById(containerId);
  el.innerHTML='';

  quests.forEach((q,qi)=>{
    const prevDone=qi===0||isQuestDone(quests[qi-1]);
    const locked=!prevDone;
    const tasks=[...q.tasks,...(state.customTasks[q.id]||[])];
    const checkedCount=tasks.filter(t=>state.checked[t.id]).length;
    const allDone=checkedCount===tasks.length&&tasks.length>0;
    const progress=tasks.length?Math.round((checkedCount/tasks.length)*100):0;

    const card=document.createElement('div');
    card.className='quest-card'+(allDone?' done':prevDone?' active':locked?' locked':'');

    const badgeText=allDone?'Cleared':locked?'Locked':'In progress';
    const badgeClass=allDone?'badge-done':locked?'badge-locked':qi===quests.length-1?'badge-boss':'badge-active';

    let tasksHtml='';
    if(!locked){
      tasksHtml=tasks.map(t=>{
        const checked=!!state.checked[t.id];
        return `<div class="task-row">
          <div class="task-check${checked?' checked':''}" onclick="toggleTask('${t.id}','${q.id}',${t.exp})">${checked?'✓':''}</div>
          <div class="task-info">
            <div class="task-name">${t.name}</div>
            ${t.note?`<div class="task-note">${t.note}</div>`:''}
          </div>
          <div class="task-exp">+${t.exp} EXP</div>
        </div>`;
      }).join('');
    }

    const barClass=allDone?'bar-done':locked?'bar-locked':'bar-active';

    card.innerHTML=`
      <div class="quest-header" onclick="toggleCard(this)">
        <div class="quest-icon">${q.icon}</div>
        <div class="quest-meta">
          <div class="quest-name">${q.name}</div>
          <div class="quest-sub">${q.sub}</div>
        </div>
        <span class="quest-badge ${badgeClass}">${badgeText}</span>
      </div>
      <div class="quest-body">
        <div class="mini-bar-track"><div class="mini-bar ${barClass}" style="width:${progress}%"></div></div>
        ${tasksHtml}
        ${!locked?`
        <button class="add-btn" onclick="openAddForm('${q.id}',this)">+ add task</button>
        <div class="add-form" id="form-${q.id}">
          <input type="text" placeholder="Task name..." id="task-name-${q.id}"/>
          <input type="text" placeholder="Note (optional)..." id="task-note-${q.id}"/>
          <div class="form-row">
            <input type="number" placeholder="EXP" id="task-exp-${q.id}" style="width:80px" value="1" min="0.25" step="0.25"/>
            <button class="btn-sm btn-confirm" onclick="addCustomTask('${q.id}')">Add</button>
            <button class="btn-sm btn-cancel" onclick="closeAddForm('${q.id}')">Cancel</button>
          </div>
        </div>`:''}
      </div>`;

    el.appendChild(card);
  });
}

function isQuestDone(q){
  const tasks=[...q.tasks,...(state.customTasks[q.id]||[])];
  return tasks.length>0&&tasks.every(t=>state.checked[t.id]);
}

function toggleCard(header){
  const body=header.nextElementSibling;
  if(!body) return;
  body.classList.toggle('open');
}

function toggleTask(taskId,questId,exp){
  const wasChecked=!!state.checked[taskId];
  state.checked[taskId]=!wasChecked;
  updateStreak();
  const expNow=getTotalExp();
  const lvlBefore=getLevel(wasChecked?expNow+exp:expNow-exp);
  const lvlNow=getLevel(expNow);
  if(!wasChecked&&lvlNow>lvlBefore){
    showToast('Level up!','You reached Level '+lvlNow,'Rank: '+getRank(expNow)[1]);
  }
  if(!wasChecked){
    const allQuests=[...DEFAULT_MIND,...DEFAULT_BODY];
    const quest=allQuests.find(q=>q.id===questId);
    if(quest&&isQuestDone(quest)){
      addLog('Quest cleared: '+quest.name);
      showToast('Quest cleared',quest.name,'The System acknowledges your growth.');
    }
  }
  saveState();
  renderAll();
}

function openAddForm(qid,btn){
  document.querySelectorAll('.add-form').forEach(f=>f.classList.remove('open'));
  const form=document.getElementById('form-'+qid);
  if(form) form.classList.add('open');
}
function closeAddForm(qid){
  const form=document.getElementById('form-'+qid);
  if(form) form.classList.remove('open');
}
function addCustomTask(qid){
  const name=document.getElementById('task-name-'+qid)?.value?.trim();
  if(!name) return;
  const note=document.getElementById('task-note-'+qid)?.value?.trim()||'';
  const exp=parseFloat(document.getElementById('task-exp-'+qid)?.value)||1;
  const id='custom_'+Date.now();
  if(!state.customTasks[qid]) state.customTasks[qid]=[];
  state.customTasks[qid].push({id,name,note,exp});
  closeAddForm(qid);
  saveState();
  renderAll();
}

// ── TOAST ──
function showToast(title,msg,sub=''){
  const wrap=document.getElementById('toast-wrap');
  const t=document.createElement('div');
  t.className='toast';
  t.innerHTML=`<div class="toast-sys">— system alert —</div>
    <div class="toast-msg">${title}</div>
    <div class="toast-sub">${msg}${sub?'<br><span style="color:var(--muted);font-size:10px">'+sub+'</span>':''}</div>`;
  wrap.appendChild(t);
  setTimeout(()=>t.remove(),3000);
}

// ── LOG ──
function addLog(text){
  const date=new Date().toLocaleString('en-PH',{dateStyle:'medium',timeStyle:'short'});
  state.log.unshift({date,text});
  if(state.log.length>30) state.log=state.log.slice(0,30);
  saveState();
}

// ── REPORT ──
function renderReport(){
  document.getElementById('report-streak').textContent=state.streak||0;

  // Week grid
  const grid=document.getElementById('week-grid');
  grid.innerHTML='';
  const days=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const today=new Date();
  for(let i=6;i>=0;i--){
    const d=new Date(today);
    d.setDate(today.getDate()-i);
    const key=d.toISOString().slice(0,10);
    const isToday=i===0;
    const active=!!state.weekActivity[key];
    const dot=document.createElement('div');
    dot.className='day-dot'+(active?' active':'')+(isToday?' today':'');
    dot.innerHTML=days[d.getDay()]+'<span>'+(d.getDate())+'</span>';
    grid.appendChild(dot);
  }

  // Bar chart
  const chart=document.getElementById('bar-chart');
  const allQuests=[...DEFAULT_MIND,...DEFAULT_BODY];
  let html='';
  allQuests.forEach(q=>{
    const tasks=[...q.tasks,...(state.customTasks[q.id]||[])];
    const done=tasks.filter(t=>state.checked[t.id]).length;
    const pct=tasks.length?Math.round((done/tasks.length)*100):0;
    html+=`<div style="margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:11px;color:var(--muted);margin-bottom:3px">
        <span>${q.icon} ${q.name}</span><span>${done}/${tasks.length}</span>
      </div>
      <div style="background:var(--bg2);border-radius:3px;height:6px;overflow:hidden">
        <div style="width:${pct}%;height:100%;background:${pct===100?'var(--green)':'var(--purple)'};border-radius:3px;transition:width .6s ease"></div>
      </div>
    </div>`;
  });
  chart.innerHTML=html;

  // Log
  const logEl=document.getElementById('log-list');
  if(!state.log.length){
    logEl.innerHTML='<div class="log-entry"><div class="log-date">—</div><div class="log-text">No activity logged yet. Complete a quest to begin.</div></div>';
  } else {
    logEl.innerHTML=state.log.map(l=>`
      <div class="log-entry">
        <div class="log-date">${l.date}</div>
        <div class="log-text">${l.text}</div>
      </div>`).join('');
  }
}

// ── TABS ──
function switchTab(tab){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  event.target.classList.add('active');
  document.getElementById('tab-'+tab).classList.add('active');
  if(tab==='report') renderReport();
}

function renderAll(){
  renderStats();
  renderQuests(DEFAULT_MIND,'quest-list-mind');
  renderQuests(DEFAULT_BODY,'quest-list-body');
}

// ── INIT ──
updateStreak();
renderAll();

// Daily reset check
const today=new Date().toISOString().slice(0,10);
const lastReset=localStorage.getItem('sl_last_reset');
if(lastReset!==today){
  addLog('New day started — '+today);
  localStorage.setItem('sl_last_reset',today);
}
</script>
</body>
</html>
