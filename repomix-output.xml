const adminNavigation = require('./server/routes/admin.navigation');
const adminUpload = require('./server/routes/admin.upload');
const adminSettings = require('./server/routes/admin.settings');

const app = express();
const PORT = process.env.PORT || 3000;

// Production Hardening: Validate Environment
const requiredEnv = ['DB_HOST', 'DB_USER', 'DB_PASSWORD', 'DB_NAME', 'FTP_HOST', 'FTP_USER', 'FTP_PASS'];
const missingEnv = requiredEnv.filter(k => !process.env[k]);
if (missingEnv.length > 0) {
  console.error('❌ Missing required environment variables:', missingEnv.join(', '));
  process.exit(1);
}

app.use(cors());

// Global Error Handler for uncaught promises
process.on('unhandledRejection', (reason, promise) => {
  console.error('⚠️ Unhandled Rejection at:', promise, 'reason:', reason);
});

process.on('uncaughtException', (err) => {
  console.error('❌ Uncaught Exception:', err.message);
  // Keep server alive or exit(1) to let PM2 restart it
});

app.use((req, res, next) => {
  res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
  res.setHeader('Pragma', 'no-cache');
  res.setHeader('Expires', '0');
  next();
});

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public'), {
  etag: false,
  lastModified: false,
  setHeaders: (res, filePath) => {
    if (filePath.endsWith('navigation.json')) {
      res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
      res.setHeader('Pragma', 'no-cache');
      res.setHeader('Expires', '0');
    }
  }
}));
app.use(helmet({ contentSecurityPolicy: false }));
app.use(rateLimit({
  windowMs: 60 * 1000,
  max: 100,
  message: { error: 'Too many requests, slow down' }
}));

app.use('/api', publicRoutes);
app.use('/api/admin', adminAuth);

// Authenticated Admin Routes
app.use('/api/admin', requireAuth);
app.use('/api/admin/stats',       adminStats);
app.use('/api/admin/buildings',   adminBuildings);
app.use('/api/admin/floors',      adminFloors);
app.use('/api/admin/offices',     adminOffices);
app.use('/api/admin/images',      adminImages);
app.use('/api/admin/coordinates', adminCoordinates);
app.use('/api/admin/navigation',  adminNavigation);
app.use('/api/admin/upload', adminUpload);
app.use('/api/admin/settings', adminSettings);


app.use((req, res) => {
  res.status(404).sendFile(path.join(__dirname, 'public', 'index.html'));
});

app.use((err, req, res, next) => {
  console.error('❌ Server error:', err.message);
  res.status(500).json({ error: 'Something went wrong' });
});

app.listen(PORT, () => {
  console.log(` Server running on http://localhost:${PORT}`);
  console.log(` Admin panel  → http://localhost:${PORT}/admin.html`);
});
