function setupSearch() {
  const input    = document.getElementById('searchInput');
  const btn      = document.getElementById('searchBtn');
  const clearBtn = document.getElementById('clearSearch');
  const results  = document.getElementById('searchResults');
  if (!input || !results) return;

  const makeItem = (icon, name, location) => {
    const item = document.createElement('div');
    item.className = 'search-result-item';
    item.innerHTML = `
      <span class="result-icon">${icon}</span>
      <div>
        <div class="result-name">${name}</div>
        <div class="result-location">${location}</div>
      </div>`;
    return item;
  };

  const selectResult = (match) => {
    results.classList.remove('active');
    input.value = '';
    if (clearBtn) clearBtn.style.display = 'none';

    // 1. Highlight the building
    window.app.highlightBuilding(match.buildingId);

    // 2. Prepare for touch interaction
    clearTimeout(window.app._tappedBuildingTimer);
    window.app.tappedBuilding = match.buildingId;

    // 3. Scroll to the building
    const mapWrapper = document.getElementById('mapWrapper');
    const building = window.app.buildingsData[match.buildingId];

    if (building && building.coordinates && building.coordinates.length > 0) {
      // Calculate center of building
      const avgX = building.coordinates.reduce((sum, c) => sum + c.x, 0) / building.coordinates.length;
      const avgY = building.coordinates.reduce((sum, c) => sum + c.y, 0) / building.coordinates.length;

      const mapW = mapWrapper.offsetWidth;
      const mapH = mapWrapper.offsetHeight;

      // Scroll into view
      const mapTop = mapWrapper.getBoundingClientRect().top + window.scrollY;
      const buildingRelativeY = (avgY / window.app.originalMapHeight) * mapH;
      const targetScroll = mapTop + buildingRelativeY - (window.innerHeight / 2);

      window.scrollTo({ top: Math.max(0, targetScroll), behavior: 'smooth' });

      // 4. IMPORTANT: Manually show the tooltip for touch devices
      const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
      if (isTouchDevice) {
        // Create a fake event object for showTooltip
        const rect = mapWrapper.getBoundingClientRect();
        const fakeEvent = {
          clientX: (avgX / window.app.originalMapWidth) * mapW + rect.left,
          clientY: (avgY / window.app.originalMapHeight) * mapH + rect.top
        };
        window.app.showTooltip(building, fakeEvent);

        // Set timer to hide it
        window.app._tappedBuildingTimer = setTimeout(() => {
          window.app.hideTooltip();
          if (window.app.tappedBuilding === match.buildingId) window.app.tappedBuilding = null;
        }, 4000);
      }
    } else {
      mapWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };

  const doSearch = () => {
    const q = input.value.trim();
    if (clearBtn) clearBtn.style.display = q.length > 0 ? 'block' : 'none';
    if (q.length < 2) { results.classList.remove('active'); return; }

    const matches = window.app.searchIndex.filter(item => {
      if (!item.searchText) return false;
      if (item.searchText.includes(q.toLowerCase())) return true;
      const words   = item.name.split(' ').filter(w => w.length > 0);
      const acronym = words.map(w => w[0]).join('').toLowerCase();
      if (acronym.includes(q.toLowerCase())) return true;
      return words.some(w => w.toLowerCase().startsWith(q.toLowerCase()));
    });

    results.innerHTML = '';

    if (matches.length === 0) {
      const noRes = makeItem('🔍', `No results for "${q}"`, 'Try a different keyword');
      noRes.style.cursor = 'default';
      results.appendChild(noRes);
      results.classList.add('active');
      return;
    }

    const seen = new Set();
    matches
      .filter(m => { if (seen.has(m.buildingId)) return false; seen.add(m.buildingId); return true; })
      .slice(0, 8)
      .forEach(match => {
        const icon = match.type === 'building'
          ? '<i class="fas fa-building"></i>'
          : '<i class="fas fa-file-lines"></i>';
        const sub  = match.type === 'office' ? `In ${match.buildingName}` : 'Building';
        const item = makeItem(icon, match.name, sub);

        // Use click for everything - modern mobile browsers handle it well 
        // and it avoids the double-trigger issue with touchend
        item.addEventListener('click', (e) => {
          e.preventDefault();
          selectResult(match);
        });

        results.appendChild(item);
      });

    results.classList.add('active');
  };

  input.addEventListener('input', doSearch);
  if (btn) btn.addEventListener('click', (e) => { e.preventDefault(); doSearch(); });
  input.addEventListener('keypress', (e) => { if (e.key === 'Enter') doSearch(); });

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      input.value = '';
      results.classList.remove('active');
      clearBtn.style.display = 'none';
      window.app.clearHighlights();
      input.focus();
    });
  }

  document.addEventListener('click', (e) => {
    if (!results.contains(e.target) &&
        !input.contains(e.target) &&
        !e.target.closest('#searchBtn')) {
      results.classList.remove('active');
    }
  });
}
