let mapperClicks = [];
const MAPPER_MIN = 3; 
const MAPPER_MAX = 12; // Maximum points allowed
const MAPPER_W = 1050;
const MAPPER_H = 1050;

let mapperInitialized = false;

async function initMapper() {
  const imgEl = document.getElementById('mapper-img');
  if (!imgEl) return;

  // 1. Fetch override from settings, but keep working default if it fails
  try {
    const res = await apiFetch('/settings');
    if (res && res.settings && res.settings.active_map) {
      const filename = res.settings.active_map.split(/[\/\\]/).pop();
      if (filename && filename !== 'capitol-complex.jpg' && filename !== 'capitol-complex.jpeg') {
        imgEl.src = `/api/view/${filename}`;
      }
    }
  } catch (e) {
    // Fail silently: keep the hardcoded map
  }

  // 2. Initialize the rest of the mapper
  const select = document.getElementById('mapper-building-select');
  if (select) {
    select.innerHTML = '<option value="">— Select Building —</option>';
    buildings.forEach(b => {
      const opt = document.createElement('option');
      opt.value = b.id;
      opt.textContent = b.name;
      select.appendChild(opt);
    });
  }

  const svg = document.getElementById('mapper-svg');
  if (mapperInitialized) return;
  mapperInitialized = true;

  svg.addEventListener('click', (e) => {
    if (!document.getElementById('mapper-building-select').value) {
      toast('⚠️ Select a building first', 'error');
      return;
    }
    const rect = imgEl.getBoundingClientRect(); 
    const px = e.clientX - rect.left;
    const py = e.clientY - rect.top;
    const mx = Math.round((px / rect.width) * MAPPER_W);
    const my = Math.round((py / rect.height) * MAPPER_H);
    mapperClicks.push({ x: mx, y: my, px, py });
    renderMapperPoints();
  });
}

function renderMapperPoints() {
  const g = document.getElementById('mapper-markers-g');
  const poly = document.getElementById('mapper-poly-preview');
  const coordBox = document.getElementById('mapper-coords');
  const status = document.getElementById('mapper-status');
  const saveBtn = document.getElementById('mapper-save-btn');
  const img = document.getElementById('mapper-img');

  g.innerHTML = '';
  coordBox.innerHTML = '';

  if (mapperClicks.length === 0) {
    coordBox.innerHTML = 'No points captured.';
    poly.setAttribute('points', '');
  } else {
    const rect = img.getBoundingClientRect();
    const pointsStr = mapperClicks.map(c => {
      const displayX = (c.x / MAPPER_W) * rect.width;
      const displayY = (c.y / MAPPER_H) * rect.height;
      return `${displayX},${displayY}`;
    }).join(' ');
    
    poly.setAttribute('points', pointsStr);

    mapperClicks.forEach((c, i) => {
      const displayX = (c.x / MAPPER_W) * rect.width;
      const displayY = (c.y / MAPPER_H) * rect.height;

      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('cx', displayX);
      circle.setAttribute('cy', displayY);
      circle.setAttribute('r', '6');
      circle.setAttribute('fill', '#ff4f6a');
      circle.setAttribute('stroke', 'white');
      circle.setAttribute('stroke-width', '2');
      g.appendChild(circle);

      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('x', displayX);
      text.setAttribute('y', displayY - 10);
      text.setAttribute('text-anchor', 'middle');
      text.setAttribute('fill', 'white');
      text.setAttribute('font-size', '10px');
      text.setAttribute('font-weight', 'bold');
      text.textContent = i + 1;
      g.appendChild(text);

      coordBox.innerHTML += `<div>Point ${i+1}: ${c.x}, ${c.y}</div>`;
    });
  }

  if (mapperClicks.length >= MAPPER_MIN) {
    status.textContent = `✅ Ready (${mapperClicks.length} points)`;
    if (mapperClicks.length >= MAPPER_MAX) {
      status.textContent = `🔥 Maximum Reached (${mapperClicks.length} points)`;
    }
    status.className = 'tag tag-green';
    saveBtn.disabled = false;
  } else {
    status.textContent = `Need ${MAPPER_MIN - mapperClicks.length} more points...`;
    status.className = 'tag tag-purple';
    saveBtn.disabled = true;
  }
}

function resetMapper() {
  mapperClicks = [];
  renderMapperPoints();
}

async function saveMapperCoords() {
  const bid = document.getElementById('mapper-building-select').value;
  if (!bid) return;

  if (!confirm(`Save these ${mapperClicks.length} coordinates to the system?`)) return;

  const data = await apiFetch(`/coordinates/bulk/${bid}`, {
    method: 'POST',
    body: JSON.stringify({ coordinates: mapperClicks.map(c => ({ x: c.x, y: c.y })) })
  });

  if (data && !data.error) {
    // 1. Capture the ID and Name before resetting
    const select = document.getElementById('mapper-building-select');
    const bid = select.value;
    const bName = select.options[select.selectedIndex].text;

    toast('✅ Map updated successfully!', 'success');
    resetMapper();

    // 2. Jump to the Coordinates Tab
    showPage('coordinates'); 

    // 3. Wait for the list to load then filter and open modal
    setTimeout(async () => {
      // Reload coordinates first to ensure grouping is fresh
      if (typeof loadCoordinates === 'function') await loadCoordinates();

      // Filter the table to ONLY show this building
      const searchBox = document.querySelector('#page-coordinates .search-box');
      if (searchBox) {
        searchBox.value = bName;
        filterTable('coords-tbody', bName, [0]);
      }

      // 4. Automatically open the coordinate edit window for this building
      if (typeof openCoordsModal === 'function') {
        openCoordsModal(bid);
      }
    }, 100);
  } else {
    toast('❌ Error saving coordinates', 'error');
  }
}
