// Load & render grouped by building 
async function loadCoordinates() {
  const tbody = document.getElementById('coords-tbody');
  tbody.innerHTML = '<tr><td colspan="4" class="loading">Loading…</td></tr>';

  const data = await apiFetch('/coordinates');
  if (!data) return;

  const coords = data.coordinates || [];
  if (!coords.length) {
    tbody.innerHTML = `
      <tr><td colspan="4">
        <div class="empty-state">
          <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
          <p>No coordinates yet. Select a building and add points.</p>
        </div>
      </td></tr>`;
    return;
  }

  // group by building_id
  const grouped = {};
  coords.forEach(c => {
    if (!grouped[c.building_id]) {
      grouped[c.building_id] = {
        building_id:   c.building_id,
        building_name: c.building_name,
        points:        []
      };
    }
    grouped[c.building_id].points.push(c);
  });

  // store for modal use
  window._coordsGrouped = grouped;

  tbody.innerHTML = Object.values(grouped).map(g => `
    <tr>
      <td style="font-weight:500">${esc(g.building_name || g.building_id)}</td>
      <td>
        <span class="tag tag-green">${g.points.length} points</span>
      </td>
      <td style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted);max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        ${g.points.map(p => `(${p.x},${p.y})`).join(' → ')}
      </td>
      <td>
        <div class="actions">
          <button class="btn btn-ghost btn-sm"
            data-action="edit-coords"
            data-bid="${g.building_id}">
            Edit Coords
          </button>
        </div>
      </td>
    </tr>
  `).join('');
}

// Event delegation
document.getElementById('coords-tbody').addEventListener('click', e => {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  if (btn.dataset.action === 'edit-coords') {
    openCoordsModal(btn.dataset.bid);
  }
});

//  Open modal 
function openNewCoordsModal() {
  document.getElementById('coord-modal-title').textContent = 'Add Coordinates';
  document.getElementById('c-building-id').value = '';

  // show building selector
  const wrap = document.getElementById('c-building-select-wrap');
  if (wrap) wrap.style.display = 'block';

  const sel = document.getElementById('c-building-select');
  if (sel) {
    sel.innerHTML = '<option value="">— Select building —</option>';
    buildings.forEach(b => {
      const o       = document.createElement('option');
      o.value       = b.id;
      o.textContent = `${b.id} — ${b.name}`;
      sel.appendChild(o);
    });
  }

  renderCoordPoints([]);
  openModal('coord-modal');
}

function openCoordsModal(buildingId) {
  const group        = window._coordsGrouped?.[buildingId];
  const buildingName = group?.building_name || buildingId;
  const points       = group?.points || [];

  document.getElementById('coord-modal-title').textContent =
    `Edit Coordinates — ${buildingName}`;
  document.getElementById('c-building-id').value = buildingId;

  // hide building selector in edit mode
  const wrap = document.getElementById('c-building-select-wrap');
  if (wrap) wrap.style.display = 'none';

  renderCoordPoints(points);
  openModal('coord-modal');
}

// Render point rows 
function renderCoordPoints(points) {
  const container = document.getElementById('coord-points-container');
  container.innerHTML = '';

  // always show at least 4 rows
  const rows = points.length >= 4
    ? points
    : [...points, ...Array.from({ length: 4 - points.length }, () => ({ x: '', y: '' }))];

  rows.forEach((p, i) => addPointRow(container, i + 1, p.x, p.y));
}

function addPointRow(container, number, x = '', y = '') {
  const row = document.createElement('div');
  row.className = 'coord-point-row';
  row.style.cssText = 'display:flex;gap:10px;align-items:center;margin-bottom:10px;';
  row.innerHTML = `
    <span style="color:var(--text-muted);font-size:13px;min-width:56px;flex-shrink:0;">
      Point ${number}
    </span>
    <div style="flex:1">
      <input class="form-control coord-x" type="number" step="any"
        placeholder="X" value="${x}">
    </div>
    <div style="flex:1">
      <input class="form-control coord-y" type="number" step="any"
        placeholder="Y" value="${y}">
    </div>
    <button class="btn btn-danger btn-sm remove-point"
      style="flex-shrink:0;padding:6px 10px;" type="button">✕</button>
  `;
  row.querySelector('.remove-point').addEventListener('click', () => {
    row.remove();
    renumberPoints();
  });
  container.appendChild(row);
}

function addCoordPoint() {
  const container = document.getElementById('coord-points-container');
  const number    = container.children.length + 1;
  addPointRow(container, number);
}

function renumberPoints() {
  document.querySelectorAll('#coord-points-container .coord-point-row')
    .forEach((row, i) => {
      const label = row.querySelector('span');
      if (label) label.textContent = `Point ${i + 1}`;
    });
}

// Save all points
async function saveCoords() {
  // get building id — either from hidden input or select
  let buildingId = document.getElementById('c-building-id').value;
  const sel      = document.getElementById('c-building-select');
  if (!buildingId && sel) buildingId = sel.value;

  if (!buildingId) return toast('Select a building first', 'error');

  const rows = document.querySelectorAll('#coord-points-container .coord-point-row');
  const coordinates = [];

  rows.forEach(row => {
    const x = row.querySelector('.coord-x').value;
    const y = row.querySelector('.coord-y').value;
    if (x !== '' && y !== '') {
      coordinates.push({ x: parseFloat(x), y: parseFloat(y) });
    }
  });

  if (coordinates.length < 3) {
    return toast('Need at least 3 points to form a polygon', 'error');
  }

  const data = await apiFetch(`/coordinates/bulk/${buildingId}`, {
    method: 'POST',
    body:   JSON.stringify({ coordinates })
  });

  if (!data || data.error) return toast(data?.error || 'Error saving', 'error');

  closeModal('coord-modal');
  toast('Coordinates saved', 'success');
  loadCoordinates();
}
