<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>System — Hunter's Log v2</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@300;400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box}

:root{
  --bg:#080810;
  --bg2:#0d0d1a;
  --bg3:#12121f;
  --panel:#0f0f1e;
  --panel2:#14142a;
  --border:#1e1e3a;
  --border2:#2d2d6b;
  --accent:#5c6bff;
  --accent2:#818cf8;
  --accent3:#a5b4fc;
  --gold:#e8b84b;
  --gold2:#f5d078;
  --green:#22c55e;
  --green2:#16a34a;
  --red:#ef4444;
  --blue:#38bdf8;
  --text:#f1f0ff;
  --text2:#a8a7c7;
  --muted:#4a4870;
  --muted2:#2e2c52;
  --font-title:'Syne',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --font-body:'Inter',sans-serif;
}

html{scroll-behavior:smooth}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  font-size:15px;
  min-height:100vh;
  overflow-x:hidden;
}

body::before{
  content:'';
  position:fixed;
  inset:0;
  background-image:
    linear-gradient(rgba(92,107,255,0.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(92,107,255,0.025) 1px,transparent 1px);
  background-size:48px 48px;
  pointer-events:none;
  z-index:0;
}
body::after{
  content:'';
  position:fixed;
  top:0;left:0;right:0;
  height:40vh;
  background:radial-gradient(ellipse at 50% 0%,rgba(92,107,255,0.07) 0%,transparent 70%);
  pointer-events:none;
  z-index:0;
}

.container{
  max-width:860px;
  margin:0 auto;
  padding:32px 20px 100px;
  position:relative;
  z-index:1;
}

/* HEADER */
.header{
  padding:40px 0 32px;
  margin-bottom:28px;
  border-bottom:1px solid var(--border);
  position:relative;
}
.header-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  margin-bottom:20px;
}
.system-tag{
  font-family:var(--font-mono);
  font-size:10px;
  letter-spacing:3px;
  color:var(--muted);
  text-transform:uppercase;
  padding:4px 10px;
  border:1px solid var(--border2);
  border-radius:3px;
}
.system-tag span{
  display:inline-block;
  width:6px;height:6px;
  background:var(--accent);
  border-radius:50%;
  margin-right:6px;
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:.4}50%{opacity:1}}

.header-date{
  font-family:var(--font-mono);
  font-size:10px;
  color:var(--muted);
  letter-spacing:1px;
}
.system-name{
  font-family:var(--font-title);
  font-size:36px;
  font-weight:800;
  color:var(--text);
  letter-spacing:-1px;
  line-height:1;
  margin-bottom:6px;
}
.system-sub{
  font-family:var(--font-mono);
  font-size:11px;
  color:var(--accent2);
  letter-spacing:2px;
}

/* STATS */
.stat-row{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
  margin-bottom:16px;
}
.stat-card{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:6px;
  padding:14px 12px;
  position:relative;
  overflow:hidden;
  transition:border-color .2s;
}
.stat-card:hover{border-color:var(--border2)}
.stat-card::after{
  content:'';
  position:absolute;
  bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--accent),transparent);
  opacity:0;
  transition:opacity .2s;
}
.stat-card:hover::after{opacity:.5}
.stat-label{
  font-family:var(--font-mono);
  font-size:9px;
  letter-spacing:2px;
  color:var(--muted);
  text-transform:uppercase;
  margin-bottom:8px;
}
.stat-val{
  font-family:var(--font-title);
  font-size:26px;
  font-weight:700;
  color:var(--accent3);
  line-height:1;
}
.stat-val.gold{color:var(--gold)}
.stat-val.green{color:var(--green)}
.stat-val.blue{color:var(--blue)}

/* EXP BAR */
.exp-section{margin-bottom:24px}
.exp-meta{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:8px;
}
.exp-label{
  font-family:var(--font-mono);
  font-size:10px;
  letter-spacing:2px;
  color:var(--muted);
  text-transform:uppercase;
}
.exp-nums{
  font-family:var(--font-mono);
  font-size:10px;
  color:var(--accent2);
}
.exp-track{
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:3px;
  height:6px;
  overflow:hidden;
}
.exp-fill{
  height:100%;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  border-radius:2px;
  transition:width 1s cubic-bezier(.4,0,.2,1);
  position:relative;
}
.exp-fill::after{
  content:'';
  position:absolute;
  top:0;right:0;bottom:0;width:30px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,0.4));
  animation:shimmer 2s ease-in-out infinite;
}
@keyframes shimmer{0%,100%{opacity:0}50%{opacity:1}}

/* TABS */
.tabs{
  display:flex;
  gap:2px;
  margin-bottom:24px;
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:6px;
  padding:3px;
}
.tab{
  flex:1;padding:9px;
  border:none;border-radius:4px;
  background:transparent;
  color:var(--muted);
  font-family:var(--font-mono);
  font-size:10px;
  letter-spacing:2px;
  cursor:pointer;
  transition:all .15s;
  text-transform:uppercase;
}
.tab.active{
  background:var(--bg2);
  color:var(--accent3);
  border:1px solid var(--border2);
}
.tab:hover:not(.active){color:var(--accent2)}

/* SECTION HEAD */
.section-head{
  display:flex;align-items:center;gap:10px;
  margin-bottom:12px;
}
.section-label{
  font-family:var(--font-mono);
  font-size:9px;letter-spacing:3px;
  color:var(--muted);text-transform:uppercase;
  white-space:nowrap;
}
.section-line{flex:1;height:1px;background:var(--border)}

/* QUEST CARD */
.quest-card{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:8px;
  margin-bottom:8px;
  overflow:hidden;
  transition:border-color .2s,background .2s;
}
.quest-card.active{border-color:var(--border2)}
.quest-card.done{border-color:#1a3a28;background:#09150f}
.quest-card.locked{opacity:.35;pointer-events:none}

.quest-header{
  display:flex;align-items:center;gap:12px;
  padding:14px 16px;
  cursor:pointer;user-select:none;
}
.quest-icon{
  width:34px;height:34px;
  border-radius:6px;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;flex-shrink:0;
  background:var(--bg2);
  border:1px solid var(--border);
}
.quest-meta{flex:1;min-width:0}
.quest-name{
  font-family:var(--font-title);
  font-size:13px;font-weight:700;
  color:var(--text);margin-bottom:2px;
}
.quest-card.done .quest-name{color:var(--green2);text-decoration:line-through}
.quest-sub{font-size:11px;color:var(--muted);font-family:var(--font-mono)}
.quest-badge{
  font-family:var(--font-mono);font-size:9px;
  padding:3px 10px;border-radius:2px;
  white-space:nowrap;flex-shrink:0;
  letter-spacing:1px;text-transform:uppercase;
}
.badge-active{background:rgba(92,107,255,0.1);color:var(--accent2);border:1px solid var(--border2)}
.badge-done{background:rgba(34,197,94,0.08);color:var(--green);border:1px solid #1a3a28}
.badge-locked{background:transparent;color:var(--muted2);border:1px solid var(--border)}
.badge-final{background:rgba(232,184,75,0.08);color:var(--gold);border:1px solid #3a3010}

.quest-body{
  display:none;
  padding:0 16px 14px;
  border-top:1px solid var(--border);
}
.quest-body.open{display:block}

.mini-bar-track{
  background:var(--bg2);
  border-radius:2px;height:3px;
  margin:10px 0 14px;overflow:hidden;
}
.mini-bar{height:100%;border-radius:2px;transition:width .5s ease}
.bar-active{background:var(--accent)}
.bar-done{background:var(--green2)}
.bar-locked{background:var(--muted2)}

/* TASK */
.task-row{
  display:flex;align-items:flex-start;gap:10px;
  padding:8px 0;
  border-bottom:1px solid rgba(30,30,58,0.6);
}
.task-row:last-child{border-bottom:none}
.task-check{
  width:16px;height:16px;
  border:1px solid var(--border2);
  border-radius:3px;
  background:var(--bg);
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;margin-top:2px;
  transition:all .15s;
  font-size:10px;color:transparent;
}
.task-check.checked{
  background:var(--accent);
  color:#fff;border-color:var(--accent);
}
.task-check:hover{border-color:var(--accent)}
.task-info{flex:1}
.task-name{
  font-size:13px;color:var(--text);
  line-height:1.4;font-weight:400;
}
.task-check.checked + .task-info .task-name{
  color:var(--green);text-decoration:line-through;opacity:.6;
}
.task-note{
  font-size:10px;color:var(--muted);
  font-family:var(--font-mono);margin-top:3px;
}
.task-exp{
  font-family:var(--font-mono);font-size:10px;
  color:var(--gold);flex-shrink:0;margin-top:3px;
}

/* ADD TASK */
.add-btn{
  display:flex;align-items:center;gap:8px;
  background:transparent;
  border:1px dashed var(--muted2);
  border-radius:4px;
  color:var(--muted);
  font-family:var(--font-mono);font-size:10px;
  letter-spacing:1px;
  padding:7px 12px;
  cursor:pointer;width:100%;
  margin-top:8px;transition:all .15s;
  text-transform:uppercase;
}
.add-btn:hover{border-color:var(--accent);color:var(--accent2)}

.add-form{
  display:none;margin-top:8px;
  background:var(--bg2);
  border:1px solid var(--border2);
  border-radius:6px;padding:12px;
  gap:8px;flex-direction:column;
}
.add-form.open{display:flex}
.add-form input{
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:4px;
  color:var(--text);
  font-family:var(--font-body);font-size:13px;
  padding:8px 10px;outline:none;
  transition:border-color .15s;
}
.add-form input:focus{border-color:var(--accent)}
.add-form input::placeholder{color:var(--muted2)}
.form-row{display:flex;gap:8px}
.btn-sm{
  padding:7px 14px;border-radius:4px;
  font-family:var(--font-mono);font-size:10px;
  cursor:pointer;border:1px solid;
  transition:all .15s;letter-spacing:1px;
  text-transform:uppercase;
}
.btn-confirm{background:var(--accent);border-color:var(--accent);color:#fff}
.btn-confirm:hover{opacity:.85}
.btn-cancel{background:transparent;border-color:var(--border);color:var(--muted)}
.btn-cancel:hover{border-color:var(--red);color:var(--red)}

/* REPORT */
.report-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.report-card{
  background:var(--panel);border:1px solid var(--border);
  border-radius:8px;padding:16px;
}
.report-title{
  font-family:var(--font-mono);font-size:9px;
  letter-spacing:3px;color:var(--muted);
  text-transform:uppercase;margin-bottom:14px;
}
.streak-num{
  font-family:var(--font-title);font-size:52px;
  font-weight:800;color:var(--gold);line-height:1;
}
.streak-label{font-family:var(--font-mono);font-size:10px;color:var(--muted);margin-top:6px}
.week-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.day-dot{
  aspect-ratio:1;border-radius:3px;
  background:var(--bg2);border:1px solid var(--border);
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  font-family:var(--font-mono);font-size:8px;color:var(--muted);
}
.day-dot.active{background:rgba(92,107,255,0.15);border-color:var(--border2);color:var(--accent2)}
.day-dot.today{border-color:var(--gold);color:var(--gold)}
.day-dot span{font-size:7px;margin-top:1px;opacity:.6}

.log-entry{
  padding:10px 14px;
  background:var(--bg2);border:1px solid var(--border);
  border-radius:6px;margin-bottom:6px;
}
.log-date{color:var(--muted);font-size:9px;font-family:var(--font-mono);margin-bottom:3px;letter-spacing:1px}
.log-text{color:var(--accent2);font-family:var(--font-mono);font-size:11px}

/* TOAST */
.toast-wrap{
  position:fixed;top:20px;left:50%;transform:translateX(-50%);
  z-index:100;pointer-events:none;
  display:flex;flex-direction:column;gap:6px;align-items:center;
}
.toast{
  background:var(--panel2);
  border:1px solid var(--border2);
  border-radius:6px;
  padding:12px 24px;text-align:center;
  animation:toastIn 2.8s ease forwards;
  min-width:240px;
}
@keyframes toastIn{
  0%{opacity:0;transform:translateY(-12px)}
  15%{opacity:1;transform:translateY(0)}
  75%{opacity:1;transform:translateY(0)}
  100%{opacity:0;transform:translateY(-6px)}
}
.toast-tag{font-family:var(--font-mono);font-size:9px;letter-spacing:3px;color:var(--muted);margin-bottom:4px;text-transform:uppercase}
.toast-msg{font-family:var(--font-title);font-size:15px;font-weight:700;color:var(--text)}
.toast-sub{font-family:var(--font-mono);font-size:10px;color:var(--accent2);margin-top:3px}

.tab-panel{display:none}
.tab-panel.active{display:block}

.footer{
  text-align:center;margin-top:48px;
  font-family:var(--font-mono);font-size:9px;
  color:var(--muted2);letter-spacing:3px;text-transform:uppercase;
}

@media(max-width:600px){
  .stat-row{grid-template-columns:repeat(2,1fr)}
  .report-grid{grid-template-columns:1fr}
  .system-name{font-size:26px}
  .tab{font-size:9px;padding:8px 4px}
}
</style>
</head>
<body>

<div class="toast-wrap" id="toast-wrap"></div>

<div class="container">

  <div class="header">
    <div class="header-top">
      <div class="system-tag"><span></span>System Online</div>
      <div class="header-date" id="header-date"></div>
    </div>
    <div class="system-name">Hunter's Log</div>
    <div class="system-sub" id="rank-label">Initiate · Level 1</div>
  </div>

  <div class="stat-row">
    <div class="stat-card">
      <div class="stat-label">Level</div>
      <div class="stat-val" id="stat-level">1</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total EXP</div>
      <div class="stat-val gold" id="stat-exp">0</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Completed</div>
      <div class="stat-val green" id="stat-quests">0/0</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Streak</div>
      <div class="stat-val blue" id="stat-streak">0</div>
    </div>
  </div>

  <div class="exp-section">
    <div class="exp-meta">
      <span class="exp-label">Progress to next level</span>
      <span class="exp-nums" id="exp-pct">0 / 5 EXP</span>
    </div>
    <div class="exp-track">
      <div class="exp-fill" id="exp-bar" style="width:0%"></div>
    </div>
  </div>

  <div class="tabs">
    <button class="tab active" onclick="switchTab('mind',this)">Dev Skills</button>
    <button class="tab" onclick="switchTab('body',this)">Physical</button>
    <button class="tab" onclick="switchTab('life',this)">Life Goals</button>
    <button class="tab" onclick="switchTab('report',this)">Report</button>
  </div>

  <div class="tab-panel active" id="tab-mind">
    <div id="quest-list-mind"></div>
  </div>

  <div class="tab-panel" id="tab-body">
    <div id="quest-list-body"></div>
  </div>

  <div class="tab-panel" id="tab-life">
    <div id="quest-list-life"></div>
  </div>

  <div class="tab-panel" id="tab-report">
    <div class="report-grid">
      <div class="report-card">
        <div class="report-title">Current Streak</div>
        <div class="streak-num" id="report-streak">0</div>
        <div class="streak-label">consecutive days</div>
      </div>
      <div class="report-card">
        <div class="report-title">This Week</div>
        <div class="week-grid" id="week-grid"></div>
      </div>
    </div>
    <div class="report-card" style="margin-bottom:12px">
      <div class="report-title">Completion by Gate</div>
      <div id="bar-chart" style="margin-top:10px"></div>
    </div>
    <div>
      <div class="section-head">
        <span class="section-label">System Log</span>
        <div class="section-line"></div>
      </div>
      <div id="log-list"></div>
    </div>
  </div>

  <div class="footer">Hunter's Log · v2.0 · build your own legend</div>
</div>

<script>
// Date display
const now = new Date();
document.getElementById('header-date').textContent =
  now.toLocaleDateString('en-PH',{weekday:'short',year:'numeric',month:'short',day:'numeric'});

const RANKS = [
  [0,'Initiate'],
  [5,'Apprentice'],
  [10,'Developer'],
  [18,'Senior Dev'],
  [25,'Tech Lead'],
  [35,'Architect'],
  [50,'Shadow Monarch']
];

const DEFAULT_MIND = [
  {
    id:'m1',name:'Gate 1 — JS Foundations',icon:'01',
    sub:'Weeks 1–2 · +8 EXP',
    tasks:[
      {id:'m1t1',name:'const, let, var — scope and closures',note:'Why does my variable disappear inside a function?',exp:2},
      {id:'m1t2',name:'.map() .filter() .reduce() — array methods',note:'These return new arrays. Understand what that means.',exp:2},
      {id:'m1t3',name:'Promises and async/await',note:'Why your fetch calls break silently',exp:2},
      {id:'m1t4',name:'Destructuring, spread, optional chaining',note:'Modern JS syntax you will see everywhere',exp:1},
      {id:'m1t5',name:'ES Modules — import vs require',note:'Why React uses import but old Node used require',exp:1},
    ]
  },
  {
    id:'m2',name:'Gate 2 — React',icon:'02',
    sub:'Weeks 3–4 · +8 EXP',
    tasks:[
      {id:'m2t1',name:'Components — functions that return UI',note:'Props flow down, events flow up. Draw this.',exp:2},
      {id:'m2t2',name:'useState — why re-renders happen',note:'Mutating state directly causes bugs. Understand why.',exp:2},
      {id:'m2t3',name:'useEffect — dependency array and cleanup',note:'Why does this run 5 times? Dep array is your answer.',exp:2},
      {id:'m2t4',name:'Lifting state to parent components',note:'When siblings need the same data',exp:1},
      {id:'m2t5',name:'React Router — client-side navigation',note:'URL changes without full page reload',exp:1},
    ]
  },
  {
    id:'m3',name:'Gate 3 — Node + Express',icon:'03',
    sub:'Weeks 5–6 · +8 EXP',
    tasks:[
      {id:'m3t1',name:'Node.js — JavaScript outside the browser',note:'Event loop basics, non-blocking I/O',exp:2},
      {id:'m3t2',name:'HTTP methods — GET POST PUT DELETE',note:'Understand the intent, not just the name',exp:2},
      {id:'m3t3',name:'Express routes, middleware, controllers',note:'Request flows through middleware before hitting route',exp:2},
      {id:'m3t4',name:'Error handling middleware',note:'The (err, req, res, next) signature',exp:1},
      {id:'m3t5',name:'Environment variables with dotenv',note:'Never hardcode secrets in your code',exp:1},
    ]
  },
  {
    id:'m4',name:'Gate 4 — NestJS + PostgreSQL',icon:'04',
    sub:'Week 7 · +6 EXP',
    tasks:[
      {id:'m4t1',name:'NestJS — modules, controllers, services',note:'The architecture you are building right now',exp:2},
      {id:'m4t2',name:'Prisma — schema design and ORM',note:'Type-safe DB access instead of raw SQL strings',exp:2},
      {id:'m4t3',name:'CRUD operations with Prisma',note:'findMany, create, update, delete',exp:1},
      {id:'m4t4',name:'JWT auth — guards and strategies',note:'Protecting routes with bearer tokens',exp:1},
    ]
  },
  {
    id:'m5',name:'Final Gate — Ship It',icon:'05',
    sub:'Week 8 · +5 EXP',
    tasks:[
      {id:'m5t1',name:'CORS + Axios interceptors',note:'Connect React frontend to NestJS backend',exp:1},
      {id:'m5t2',name:'Environment variables in production',note:'Never expose secrets in deployed code',exp:1},
      {id:'m5t3',name:'Deploy backend on Render',note:'Your API live on the internet',exp:1},
      {id:'m5t4',name:'Deploy frontend on Vercel',note:'Your UI live on the internet',exp:1},
      {id:'m5t5',name:'Explain every part to someone else',note:'If you can teach it, you own it',exp:1},
    ]
  }
];

const DEFAULT_BODY = [
  {
    id:'b1',name:'Bodyweight Foundation',icon:'B1',
    sub:'Daily · +1 EXP per session',
    tasks:[
      {id:'b1t1',name:'Push-ups — 3 sets',note:'Start 3x10. Progress to 3x20 before adding reps.',exp:0.25},
      {id:'b1t2',name:'Squats — 3 sets',note:'Bodyweight first. Form over weight.',exp:0.25},
      {id:'b1t3',name:'Plank — 60 seconds',note:'Build to 2 min. Core carries everything.',exp:0.25},
      {id:'b1t4',name:'Pull-ups or inverted rows',note:'Doorframe bar or table rows if no equipment.',exp:0.25},
    ]
  },
  {
    id:'b2',name:'Cardio',icon:'B2',
    sub:'3x per week · +1 EXP per session',
    tasks:[
      {id:'b2t1',name:'30 min run or brisk walk',note:'Zone 2 pace — you can still hold a conversation.',exp:0.5},
      {id:'b2t2',name:'10 min HIIT finisher',note:'20s work, 10s rest, 8 rounds.',exp:0.25},
      {id:'b2t3',name:'Stretch and cool down — 10 min',note:'Hip flexors, hamstrings, shoulders.',exp:0.25},
    ]
  },
  {
    id:'b3',name:'Nutrition and Recovery',icon:'B3',
    sub:'Daily · non-negotiable',
    tasks:[
      {id:'b3t1',name:'Drink 2–3L water',note:'Set a phone alarm every 2 hours.',exp:0.25},
      {id:'b3t2',name:'Protein with every meal',note:'Egg, chicken, tofu — 0.8g per kg bodyweight.',exp:0.25},
      {id:'b3t3',name:'Sleep 7–8 hours',note:'Gains happen during sleep, not training.',exp:0.25},
      {id:'b3t4',name:'No phone 30 min before bed',note:'Blue light kills melatonin. Try it for one week.',exp:0.25},
    ]
  }
];

const DEFAULT_LIFE = [
  {
    id:'l1',name:'Career — Land First Dev Job',icon:'L1',
    sub:'Priority one · life-changing EXP',
    tasks:[
      {id:'l1t1',name:'Finish Hunter\'s Log full-stack app',note:'This is your portfolio piece. Ship it.',exp:3},
      {id:'l1t2',name:'Push PGC-FIS to GitHub with documentation',note:'Government system on your profile = credibility.',exp:2},
      {id:'l1t3',name:'Apply to 3 jobs per week',note:'Junior dev, apprentice, intern-to-hire roles.',exp:1},
      {id:'l1t4',name:'Practice 2 interview questions per day',note:'Arrays, objects, async — basics they always ask.',exp:1},
      {id:'l1t5',name:'Write a 1-page resume — one page only',note:'List PGC system, tech stack, GitHub link.',exp:1},
    ]
  },
  {
    id:'l2',name:'Finance — Emergency Foundation',icon:'L2',
    sub:'Start small, stay consistent',
    tasks:[
      {id:'l2t1',name:'Save P100–500 per week — no exceptions',note:'Even P100 is the habit. The amount grows later.',exp:1},
      {id:'l2t2',name:'Track every expense for one month',note:'Use a notes app. Just write it down.',exp:1},
      {id:'l2t3',name:'Learn one money concept this week',note:'Emergency fund, compound interest, 50-30-20 rule.',exp:1},
      {id:'l2t4',name:'Build a 1-month expense buffer',note:'First financial goal. It changes how you think.',exp:2},
    ]
  },
  {
    id:'l3',name:'Mental Health — Stay Functional',icon:'L3',
    sub:'Non-negotiable maintenance',
    tasks:[
      {id:'l3t1',name:'No doom scrolling after 10pm',note:'Replace with reading, journaling, or just sleeping.',exp:0.5},
      {id:'l3t2',name:'Write 3 things that went okay today',note:'Not good. Just okay. Lower the bar on hard days.',exp:0.5},
      {id:'l3t3',name:'Talk to one person today — anyone',note:'Isolation compounds everything. One message counts.',exp:0.5},
      {id:'l3t4',name:'Do one thing just because you enjoy it',note:'Not productive. Not useful. Just yours.',exp:0.5},
    ]
  }
];

let state = loadState();

function loadState(){
  try{
    const s = localStorage.getItem('hl_v2');
    if(s) return JSON.parse(s);
  }catch(e){}
  return {checked:{},customTasks:{},log:[],streak:0,lastActiveDate:null,weekActivity:{}};
}
function saveState(){
  try{ localStorage.setItem('hl_v2', JSON.stringify(state)); }catch(e){}
}

function getTotalExp(){
  let total = 0;
  const all = [...DEFAULT_MIND,...DEFAULT_BODY,...DEFAULT_LIFE];
  all.forEach(q=>{
    const tasks = [...q.tasks,...(state.customTasks[q.id]||[])];
    tasks.forEach(t=>{ if(state.checked[t.id]) total += t.exp; });
  });
  return Math.round(total*10)/10;
}

function getLevel(exp){ return Math.floor(exp/5)+1; }

function getRank(exp){
  let r = RANKS[0];
  for(const entry of RANKS){ if(exp>=entry[0]) r=entry; }
  return r;
}

function updateStreak(){
  const today = new Date().toISOString().slice(0,10);
  if(state.lastActiveDate===today) return;
  const yesterday = new Date(Date.now()-86400000).toISOString().slice(0,10);
  if(state.lastActiveDate===yesterday){ state.streak=(state.streak||0)+1; }
  else{ state.streak=1; }
  state.lastActiveDate = today;
  state.weekActivity[today] = true;
  saveState();
}

function renderStats(){
  const exp = getTotalExp();
  const lvl = getLevel(exp);
  const rank = getRank(exp);
  const expInLevel = exp%5;
  const pct = Math.round((expInLevel/5)*100);

  document.getElementById('stat-level').textContent = lvl;
  document.getElementById('stat-exp').textContent = exp;
  document.getElementById('rank-label').textContent = rank[1]+' · Level '+lvl;
  document.getElementById('report-streak').textContent = state.streak||0;

  const all = [...DEFAULT_MIND,...DEFAULT_BODY,...DEFAULT_LIFE];
  let done=0,total=0;
  all.forEach(q=>{
    const tasks = [...q.tasks,...(state.customTasks[q.id]||[])];
    tasks.forEach(t=>{ total++; if(state.checked[t.id]) done++; });
  });
  document.getElementById('stat-quests').textContent = done+'/'+total;
  document.getElementById('stat-streak').textContent = state.streak||0;
  document.getElementById('exp-bar').style.width = pct+'%';
  document.getElementById('exp-pct').textContent = expInLevel.toFixed(1)+' / 5 EXP';
}

function isQuestDone(q){
  const tasks = [...q.tasks,...(state.customTasks[q.id]||[])];
  return tasks.length>0 && tasks.every(t=>state.checked[t.id]);
}

function renderQuests(quests, containerId){
  const el = document.getElementById(containerId);
  el.innerHTML = '';
  quests.forEach((q,qi)=>{
    const prevDone = qi===0 || isQuestDone(quests[qi-1]);
    const locked = !prevDone;
    const tasks = [...q.tasks,...(state.customTasks[q.id]||[])];
    const checkedCount = tasks.filter(t=>state.checked[t.id]).length;
    const allDone = checkedCount===tasks.length && tasks.length>0;
    const progress = tasks.length ? Math.round((checkedCount/tasks.length)*100) : 0;

    const card = document.createElement('div');
    card.className = 'quest-card'+(allDone?' done':prevDone?' active':locked?' locked':'');

    const badgeText = allDone?'Cleared':locked?'Locked':qi===quests.length-1?'Final':'Active';
    const badgeClass = allDone?'badge-done':locked?'badge-locked':qi===quests.length-1?'badge-final':'badge-active';
    const barClass = allDone?'bar-done':locked?'bar-locked':'bar-active';

    let tasksHtml = '';
    if(!locked){
      tasksHtml = tasks.map(t=>{
        const checked = !!state.checked[t.id];
        return `<div class="task-row">
          <div class="task-check${checked?' checked':''}" onclick="toggleTask('${t.id}','${q.id}',${t.exp})">${checked?'✓':''}</div>
          <div class="task-info">
            <div class="task-name">${t.name}</div>
            ${t.note?`<div class="task-note">${t.note}</div>`:''}
          </div>
          <div class="task-exp">+${t.exp}</div>
        </div>`;
      }).join('');
    }

    card.innerHTML = `
      <div class="quest-header" onclick="toggleCard(this)">
        <div class="quest-icon" style="font-family:var(--font-mono);font-size:11px;color:var(--muted)">${q.icon}</div>
        <div class="quest-meta">
          <div class="quest-name">${q.name}</div>
          <div class="quest-sub">${q.sub}</div>
        </div>
        <span class="quest-badge ${badgeClass}">${badgeText}</span>
      </div>
      <div class="quest-body">
        <div class="mini-bar-track"><div class="mini-bar ${barClass}" style="width:${progress}%"></div></div>
        ${tasksHtml}
        ${!locked?`
        <button class="add-btn" onclick="openAddForm('${q.id}',this)">+ Add custom task</button>
        <div class="add-form" id="form-${q.id}">
          <input type="text" placeholder="Task name..." id="task-name-${q.id}"/>
          <input type="text" placeholder="Note (optional)..." id="task-note-${q.id}"/>
          <div class="form-row">
            <input type="number" placeholder="EXP" id="task-exp-${q.id}" style="width:80px" value="1" min="0.25" step="0.25"/>
            <button class="btn-sm btn-confirm" onclick="addCustomTask('${q.id}')">Add</button>
            <button class="btn-sm btn-cancel" onclick="closeAddForm('${q.id}')">Cancel</button>
          </div>
        </div>`:''}
      </div>`;
    el.appendChild(card);
  });
}

function toggleCard(header){
  const body = header.nextElementSibling;
  if(!body) return;
  body.classList.toggle('open');
}

function toggleTask(taskId, questId, exp){
  const wasChecked = !!state.checked[taskId];
  state.checked[taskId] = !wasChecked;
  updateStreak();
  const expNow = getTotalExp();
  const lvlBefore = getLevel(wasChecked ? expNow+exp : expNow-exp);
  const lvlNow = getLevel(expNow);
  if(!wasChecked && lvlNow>lvlBefore){
    showToast('Level Up','You reached Level '+lvlNow,'Rank: '+getRank(expNow)[1]);
  }
  if(!wasChecked){
    const all = [...DEFAULT_MIND,...DEFAULT_BODY,...DEFAULT_LIFE];
    const quest = all.find(q=>q.id===questId);
    if(quest && isQuestDone(quest)){
      addLog('Gate cleared: '+quest.name);
      showToast('Gate Cleared',quest.name,'Progress acknowledged.');
    }
  }
  saveState();
  renderAll();
}

function openAddForm(qid, btn){
  document.querySelectorAll('.add-form').forEach(f=>f.classList.remove('open'));
  const form = document.getElementById('form-'+qid);
  if(form) form.classList.add('open');
}
function closeAddForm(qid){
  const form = document.getElementById('form-'+qid);
  if(form) form.classList.remove('open');
}
function addCustomTask(qid){
  const name = document.getElementById('task-name-'+qid)?.value?.trim();
  if(!name) return;
  const note = document.getElementById('task-note-'+qid)?.value?.trim()||'';
  const exp = parseFloat(document.getElementById('task-exp-'+qid)?.value)||1;
  const id = 'custom_'+Date.now();
  if(!state.customTasks[qid]) state.customTasks[qid]=[];
  state.customTasks[qid].push({id,name,note,exp});
  closeAddForm(qid);
  saveState();
  renderAll();
}

function showToast(title, msg, sub=''){
  const wrap = document.getElementById('toast-wrap');
  const t = document.createElement('div');
  t.className = 'toast';
  t.innerHTML = `<div class="toast-tag">System Alert</div>
    <div class="toast-msg">${title}</div>
    <div class="toast-sub">${msg}${sub?'<br><span style="color:var(--muted);font-size:9px">'+sub+'</span>':''}</div>`;
  wrap.appendChild(t);
  setTimeout(()=>t.remove(), 3000);
}

function addLog(text){
  const date = new Date().toLocaleString('en-PH',{dateStyle:'medium',timeStyle:'short'});
  state.log.unshift({date,text});
  if(state.log.length>30) state.log=state.log.slice(0,30);
  saveState();
}

function renderReport(){
  document.getElementById('report-streak').textContent = state.streak||0;

  const grid = document.getElementById('week-grid');
  grid.innerHTML='';
  const days=['Su','Mo','Tu','We','Th','Fr','Sa'];
  const today = new Date();
  for(let i=6;i>=0;i--){
    const d = new Date(today);
    d.setDate(today.getDate()-i);
    const key = d.toISOString().slice(0,10);
    const isToday = i===0;
    const active = !!state.weekActivity[key];
    const dot = document.createElement('div');
    dot.className = 'day-dot'+(active?' active':'')+(isToday?' today':'');
    dot.innerHTML = days[d.getDay()]+'<span>'+d.getDate()+'</span>';
    grid.appendChild(dot);
  }

  const chart = document.getElementById('bar-chart');
  const all = [...DEFAULT_MIND,...DEFAULT_BODY,...DEFAULT_LIFE];
  let html='';
  all.forEach(q=>{
    const tasks = [...q.tasks,...(state.customTasks[q.id]||[])];
    const done = tasks.filter(t=>state.checked[t.id]).length;
    const pct = tasks.length ? Math.round((done/tasks.length)*100):0;
    html+=`<div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:10px;color:var(--muted);margin-bottom:4px;letter-spacing:1px">
        <span>${q.name}</span><span>${done}/${tasks.length}</span>
      </div>
      <div style="background:var(--bg2);border-radius:2px;height:4px;overflow:hidden">
        <div style="width:${pct}%;height:100%;background:${pct===100?'var(--green)':'var(--accent)'};border-radius:2px;transition:width .5s ease"></div>
      </div>
    </div>`;
  });
  chart.innerHTML = html;

  const logEl = document.getElementById('log-list');
  if(!state.log.length){
    logEl.innerHTML='<div class="log-entry"><div class="log-date">—</div><div class="log-text">No entries yet. Complete a gate to begin.</div></div>';
  } else {
    logEl.innerHTML = state.log.map(l=>`
      <div class="log-entry">
        <div class="log-date">${l.date}</div>
        <div class="log-text">${l.text}</div>
      </div>`).join('');
  }
}

function switchTab(tab, btn){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  if(btn) btn.classList.add('active');
  document.getElementById('tab-'+tab).classList.add('active');
  if(tab==='report') renderReport();
}

function renderAll(){
  renderStats();
  renderQuests(DEFAULT_MIND,'quest-list-mind');
  renderQuests(DEFAULT_BODY,'quest-list-body');
  renderQuests(DEFAULT_LIFE,'quest-list-life');
}

// Daily log
const today = new Date().toISOString().slice(0,10);
const lastReset = localStorage.getItem('hl_v2_reset');
if(lastReset!==today){
  addLog('Session started — '+today);
  localStorage.setItem('hl_v2_reset',today);
}

updateStreak();
renderAll();
</script>
</body>
