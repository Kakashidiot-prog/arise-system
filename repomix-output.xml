  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-card">
    <div class="login-logo">
  <img src="/images/cagayan-logo.png" alt="PGC" style="width:48px;height:48px;border-radius:50%;vertical-align:middle;margin-right:10px;border:2px solid var(--accent);">
  PGC<span>.</span>ADMIN
</div>
    <div class="login-sub">Guide Kiosk: Navigation and Service Directory.</div>
    <div class="field">
      <label>Username</label>
      <input type="text" id="login-user" placeholder="admin" autocomplete="username">
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" id="login-pass" placeholder="••••••••" autocomplete="new-password">
    </div>
    <button class="btn btn-primary btn-full" onclick="doLogin()">Sign in</button>
    <div id="login-error">Invalid credentials. Please try again.</div>
  </div>
</div>

<!-- APP -->
<div id="app">
  <aside class="sidebar">
    <div class="sidebar-top">
      <div class="brand">
        <img src="/images/cagayan-logo.png" alt="PGC">
        <span>Admin</span>
      </div>
    </div>
    
    <nav class="sidebar-nav">
      <button class="nav-tab active" data-page="dashboard"   onclick="showPage('dashboard')">Dashboard</button>
      <button class="nav-tab"        data-page="buildings"   onclick="showPage('buildings')">Buildings</button>
      <button class="nav-tab"        data-page="floors"      onclick="showPage('floors')">Floors &amp; Offices</button>
      <button class="nav-tab"        data-page="images"      onclick="showPage('images')">Images</button>
      <button class="nav-tab"        data-page="coordinates" onclick="showPage('coordinates')">Coordinates</button>
      <button class="nav-tab"        data-page="mapper"      onclick="showPage('mapper')">Building Mapper</button>
      <button class="nav-tab"        data-page="settings"    onclick="showPage('settings')">Map Settings</button>
      <button class="nav-tab" onclick="window.open('/navigation-path-editor.html', '_blank')">Navigation Editor ↗</button>
    </nav>

    <div class="sidebar-bottom">
      <div class="user-info">
        <span class="user-badge" id="user-badge"></span>
      </div>
      <button class="btn btn-ghost btn-sm btn-full" onclick="toggleTheme()" id="theme-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg> 
        Light Mode
      </button>
      <button class="btn btn-danger btn-sm btn-full" onclick="doLogout()">Sign out</button>
    </div>
  </aside>

  <div class="main">

    <!-- DASHBOARD -->
    <div class="page active" id="page-dashboard">
      <div class="page-header">
        <div class="page-title">Dashboard</div>
      </div>
      <div class="stats-row">
        <div class="stat-card"><div class="stat-val" id="s-buildings">—</div><div class="stat-label">Buildings</div></div>
        <div class="stat-card"><div class="stat-val" id="s-floors">—</div><div class="stat-label">Floors</div></div>
        <div class="stat-card"><div class="stat-val" id="s-offices">—</div><div class="stat-label">Offices</div></div>
        <div class="stat-card"><div class="stat-val" id="s-images">—</div><div class="stat-label">Images</div></div>
      </div>
      <div class="card">
        <div class="card-header"><span class="card-title">Recent Buildings</span></div>
        <table>
          <thead><tr><th>ID</th><th>Name</th><th>Category</th><th>Contact</th><th>Hours</th></tr></thead>
          <tbody id="dash-table"><tr><td colspan="5" class="loading">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- BUILDING MAPPER -->
    <div class="page" id="page-mapper">
      <div class="page-header">
        <div class="page-title">Building Mapper</div>
        <div style="display:flex; gap:10px;">
          <button class="btn btn-ghost" onclick="resetMapper()"><i class="fas fa-undo"></i> Reset Clicks</button>
          <button class="btn btn-primary" id="mapper-save-btn" onclick="saveMapperCoords()" disabled><i class="fas fa-save"></i> Save to System</button>
        </div>
      </div>

      <div style="display:grid; grid-template-columns: 300px 1fr; gap:24px; align-items: start;">
        <!-- Left: Controls -->
        <div class="card" style="padding:20px;">
          <div class="form-group">
            <label>Target Building</label>
            <select class="form-control" id="mapper-building-select" onchange="resetMapper()">
              <option value="">— Select Building —</option>
            </select>
          </div>
          <div class="instructions-box" style="margin-top:16px;">
            <strong>How to Map:</strong>
            <ol style="margin-left:20px; margin-top:8px;">
              <li>Select building</li>
              <li>Click 4 corners</li>
              <li>Top-Left → Top-Right → Bottom-Right → Bottom-Left</li>
              <li>Click Save</li>
            </ol>
          </div>
          <div id="mapper-status" class="tag tag-purple" style="margin-top:16px; width:100%; text-align:center; padding:8px;">
            Waiting for building...
          </div>
          <div id="mapper-coords" style="margin-top:16px; font-family:var(--font-mono); font-size:11px; background:var(--surface2); padding:10px; border-radius:8px; border:1px solid var(--border);">
            No points captured.
          </div>
        </div>

        <!-- Right: Map -->
        <div class="card" id="mapper-container" style="position:relative; overflow:auto; background:#000; height:700px; border:2px solid var(--accent);">
          <div id="mapper-map-wrapper" style="position:relative; width:1050px; height:1050px;">
            <img src="/images/capitol-complex.jpg" id="mapper-img" style="width:100%; height:auto; display:block; pointer-events:none;">
            <svg id="mapper-svg" style="position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:all; cursor:crosshair;">
              <polygon id="mapper-poly-preview" fill="rgba(79, 142, 255, 0.3)" stroke="#4f8eff" stroke-width="2" />
              <g id="mapper-markers-g"></g>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- BUILDINGS -->
    <div class="page" id="page-buildings">
      <div class="page-header">
        <div class="page-title">Buildings</div>
        <button class="btn btn-primary" onclick="openBuildingModal()">+ Add Building</button>
      </div>
      <div class="card">
        <div class="card-header">
          <span class="card-title">All Buildings</span>
          <input class="search-box" placeholder="Search…" oninput="filterTable('buildings-tbody',this.value,[1,2])">
        </div>
        <table>
          <thead><tr><th>ID</th><th>Name</th><th>Category</th><th>Description</th><th>Hours</th><th>Contact</th><th>Actions</th></tr></thead>
          <tbody id="buildings-tbody"><tr><td colspan="7" class="loading">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- FLOORS & OFFICES -->
    <div class="page" id="page-floors">
      <div class="page-header">
        <div class="page-title">Floors &amp; Offices</div>
        <button class="btn btn-primary" onclick="openFloorModal()">+ Add Floor</button>
      </div>
      <div style="margin-bottom:16px;display:flex;gap:10px;align-items:center;">
        <label style="color:var(--text-dim);font-size:13px;">Building:</label>
        <select class="form-control" style="width:260px" id="floor-building-filter" onchange="loadFloorsPage()">
          <option value="">— Select building —</option>
        </select>
      </div>
      <div id="floors-container">
      <div class="empty-state"><div class="icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16"/><path d="M10 22V12h4v10"/><path d="M8 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M16 18h.01"/></svg></div><p>Select a building to view its floors</p></div>
      </div>
    </div>

    <!-- IMAGES -->
    <div class="page" id="page-images">
      <div class="page-header">
        <div class="page-title">Images</div>
        <button class="btn btn-primary" onclick="openImageModal()">+ Add Image</button>
      </div>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Building Images</span>
          <input class="search-box" placeholder="Search path…" oninput="filterTable('images-tbody',this.value,[1,2])">
        </div>
        <table>
          <thead><tr><th>#</th><th>Building</th><th>Image Path</th><th>Actions</th></tr></thead>
          <tbody id="images-tbody"><tr><td colspan="4" class="loading">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- COORDINATES -->
    <div class="page" id="page-coordinates">
      <div class="page-header">
        <div class="page-title">Coordinates</div>
        <button class="btn btn-primary" onclick="openNewCoordsModal()">
          + Add Coordinates
        </button>
      </div>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Building Map Coordinates</span>
          <input class="search-box" placeholder="Search building…" oninput="filterTable('coords-tbody',this.value,[0])">
        </div>
        <table>
          <thead>
            <tr>
              <th>Building</th>
              <th>Points</th>
              <th>Preview</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="coords-tbody">
            <tr><td colspan="4" class="loading">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- MAP SETTINGS -->
    <div class="page" id="page-settings">
      <div class="page-header">
        <div class="page-title">Map Settings</div>
        <button class="btn btn-primary" onclick="saveMapSettings()"><i class="fas fa-save"></i> Save Changes</button>
      </div>
      
      <div class="card" style="max-width: 600px;">
        <div class="card-header">
          <span class="card-title">Active Base Map</span>
        </div>
        <div class="card-body" style="padding:20px;">
          <p style="color:var(--text-muted); margin-bottom:15px; font-size:14px;">
            This image will be used as the base for the Building Mapper and the main Navigation Map.
          </p>
          
          <div class="form-group">
            <label>Current Map Path</label>
            <div style="display:flex; gap:10px; margin-top:5px;">
              <input type="text" id="setting-active-map" class="form-control" placeholder="e.g. images/map.jpg" readonly>
              <label class="btn btn-ghost" style="cursor:pointer; white-space:nowrap; margin:0;">
                <i class="fas fa-upload"></i> Upload New
                <input type="file" id="map-upload-input" accept="image/*" style="display:none" onchange="handleMapUpload(this)">
              </label>
            </div>
          </div>
          
          <div id="map-settings-preview" style="margin-top:20px; border:1px solid var(--border); border-radius:8px; overflow:hidden; background:var(--surface2);">
            <div style="padding:10px; font-size:12px; border-bottom:1px solid var(--border); color:var(--text-dim);">Preview:</div>
            <img id="map-preview-img" src="" style="width:100%; height:auto; display:block; min-height:100px;">
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- MODALS -->

<!-- Building Modal -->
<div class="modal-overlay" id="building-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="building-modal-title">Add Building</div>
      <button class="modal-close" onclick="closeModal('building-modal')">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="b-id">
      <div class="form-row">
        <div class="form-group">
          <label>Building Name</label>
          <input class="form-control" id="b-name" placeholder="e.g. Main Building">
        </div>
        <div class="form-group">
          <label>Category</label>
          <input class="form-control" id="b-category" placeholder="e.g. Administrative" list="category-suggestions">
          <datalist id="category-suggestions">
            <option value="Administrative">
            <option value="Services">
            <option value="Facilities">
          </datalist>
        </div>
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea class="form-control" id="b-description" placeholder="Brief description…"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Operating Hours</label>
          <input class="form-control" id="b-hours" placeholder="e.g. Mon–Fri 8:00–17:00">
        </div>
        <div class="form-group">
          <label>Contact</label>
          <input class="form-control" id="b-contact" placeholder="e.g. (02) 123-4567">
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('building-modal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveBuilding()">Save Building</button>
    </div>
  </div>
</div>

<!-- Floor Modal -->
<div class="modal-overlay" id="floor-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="floor-modal-title">Add Floor</div>
      <button class="modal-close" onclick="closeModal('floor-modal')">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="f-id">
      <div class="form-row">
        <div class="form-group">
          <label>Building</label>
          <select class="form-control" id="f-building"></select>
        </div>
        <div class="form-group">
          <label>Floor Number</label>
          <input class="form-control" type="number" id="f-number" placeholder="1">
        </div>
      </div>
      <div class="form-group">
        <label>Floor Name</label>
        <input class="form-control" id="f-name" placeholder="e.g. Ground Floor">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('floor-modal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveFloor()">Save Floor</button>
    </div>
  </div>
</div>

<!-- Office Modal -->
<div class="modal-overlay" id="office-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="office-modal-title">Add Office</div>
      <button class="modal-close" onclick="closeModal('office-modal')">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="o-id">
      <input type="hidden" id="o-floor-id">
      <div class="form-group">
        <label>Office Name</label>
        <input class="form-control" id="o-name" placeholder="e.g. Registrar's Office">
      </div>
      <div class="form-group">
        <label>Direction</label>
        <input class="form-control" id="o-direction" placeholder="e.g. Turn left at the stairs">
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea class="form-control" id="o-description" placeholder="Brief description of office services…"></textarea>
      </div>
      <div class="form-group">
        <label>Services Offered</label>
        <textarea class="form-control" id="o-services" placeholder="List of services…"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Contact Number</label>
          <input class="form-control" id="o-contact" placeholder="e.g. (078) 123-4567">
        </div>
        <div class="form-group">
          <label>Website URL</label>
          <input class="form-control" id="o-url" placeholder="e.g. https://cagayan.gov.ph">
        </div>
      </div>
      <div class="form-group">
        <label>PDF URL (opens in new tab)</label>
        <div style="display:flex;gap:8px;align-items:center;">
          <input class="form-control" id="o-pdf" placeholder="e.g. images/charter.pdf" style="flex:1">
          <label class="btn btn-ghost btn-sm" style="cursor:pointer;white-space:nowrap;margin:0;">
            <i class="fas fa-file-pdf"></i> Upload PDF
            <input type="file" id="o-pdf-file" accept="application/pdf" style="display:none" onchange="handleOfficePdfUpload(this)">
          </label>
        </div>
      </div>
      <div class="form-group">
        <label>Photo (optional)</label>
        <div style="display:flex;gap:8px;align-items:center;">
          <input class="form-control" id="o-photo" placeholder="e.g. images/office.jpg" style="flex:1">
          <label class="btn btn-ghost btn-sm" style="cursor:pointer;white-space:nowrap;margin:0;">
            <i class="fas fa-image"></i> Upload
            <input type="file" id="o-photo-file" accept="image/*" style="display:none" onchange="handleOfficePhotoUpload(this)">
          </label>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('office-modal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveOffice()">Save Office</button>
    </div>
  </div>
</div>

<!-- Image Modal -->
<div class="modal-overlay" id="image-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="image-modal-title">Add Image</div>
      <button class="modal-close" onclick="closeModal('image-modal')">×</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="img-id">
      <div class="form-group">
        <label>Building</label>
        <select class="form-control" id="img-building"></select>
      </div>
      <div class="form-group">
        <label>Image</label>
        <div style="display:flex;gap:8px;align-items:center;">
          <input class="form-control" id="img-path" placeholder="e.g. images/building.jpg" style="flex:1">
          <label class="btn btn-ghost btn-sm" style="cursor:pointer;white-space:nowrap;margin:0;">
            <i class="fas fa-image"></i> Upload
            <input type="file" id="img-file-input" accept="image/*" style="display:none" onchange="handleImageUpload(this)">
          </label>
        </div>
        <div id="img-preview" style="margin-top:8px;display:none;">
          <img id="img-preview-img" style="max-height:120px;border-radius:8px;border:1px solid var(--border);">
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('image-modal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveImage()">Save Image</button>
    </div>
  </div>
</div>

<!-- Coordinate  -->
<div class="modal-overlay" id="coord-modal">
  <div class="modal" style="max-width:480px">
    <div class="modal-header">
      <div class="modal-title" id="coord-modal-title">Edit Coordinates</div>
      <button class="modal-close" onclick="closeModal('coord-modal')" style="width:44px;height:44px;font-size:22px;">×</button>
    </div>
    <div class="modal-body">

      <!-- hidden building id for edit mode -->
      <input type="hidden" id="c-building-id">

      <!-- building select for add mode -->
      <div class="form-group" id="c-building-select-wrap" style="display:none">
        <label>Building</label>
        <select class="form-control" id="c-building-select"></select>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <label style="color:var(--text-dim);font-size:12px;text-transform:uppercase;letter-spacing:0.5px;">
          Polygon Coordinates <span style="color:var(--text-muted)">(min. 3)</span>
        </label>
        <button class="btn btn-ghost btn-sm" type="button" onclick="addCoordPoint()">
          + Add Coords
        </button>
      </div>

      <div id="coord-points-container"></div>

      <p style="color:var(--text-muted);font-size:12px;margin-top:12px;line-height:1.5;">
        💡 Use The <strong>Coordinate Finder Tool</strong> to get X/Y values,
        then enter them here in order.
      </p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('coord-modal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveCoords()">Save All Points</button>
    </div>
  </div>
</div>

<!-- Lightbox Modal -->
<div class="modal-overlay" id="lightbox-modal" onclick="closeModal('lightbox-modal')" style="z-index:9999;">
  <div style="position:relative; max-width:90%; max-height:90%; display:flex; align-items:center; justify-content:center; pointer-events:auto;" onclick="event.stopPropagation()">
    <img id="lightbox-img" style="max-width:100%; max-height:85vh; border-radius:12px; box-shadow:0 25px 60px rgba(0,0,0,0.6); border:4px solid white; cursor:default;">
    <button class="modal-close" onclick="closeModal('lightbox-modal')" style="position:absolute; top:-40px; right:0; color:white; font-size:40px; background:none; border:none; cursor:pointer;">&times;</button>
  </div>
</div>

<!-- Confirmation Modal -->
<div id="confirm-modal" class="modal-overlay">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" id="confirm-title">Confirm Delete</div>
      <button class="modal-close" onclick="closeModal('confirm-modal')">&times;</button>
    </div>
    <div class="modal-body">
      <p id="confirm-msg">Are you sure you want to delete this?</p>
    </div>
    <div class="modal-footer" style="display: flex; gap: 10px; justify-content: flex-end;">
      <button class="btn btn-ghost" onclick="closeModal('confirm-modal')">Cancel</button>
      <button id="confirm-ok" class="btn btn-danger">Delete</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast"><div class="toast-dot"></div><span id="toast-msg"></span></div>

<!-- SCRIPTS — order matters -->
<script src="/js/admin/api.js"></script>
<script src="/js/admin/auth.js"></script>
<script src="/js/admin/state.js"></script>
<script src="/js/admin/ui.js"></script>
<script src="/js/admin/dashboard.js"></script>
<script src="/js/admin/buildings.js"></script>
<script src="/js/admin/floors.js"></script>
<script src="/js/admin/images.js"></script>
<script src="/js/admin/coordinates.js"></script>
<script src="/js/admin/mapper.js"></script>
<script src="/js/admin/settings.js"></script>
<script>
  checkAuth();
</script>

</body>
</html>
