// ── Dijkstra Shortest Path Algorithm ─────────────────────────
// Used by NavigationSystem to find the shortest road path
// between any two nodes in the navigation graph

const dijkstra = {
  findShortestPath(startId, endId, nodes, edges) {
    // Build adjacency list
    const graph = {};
    nodes.forEach(n => { graph[n.id] = []; });

    edges.forEach(e => {
      if (graph[e.from] && graph[e.to]) {
        graph[e.from].push({ id: e.to,   weight: e.weight });
        graph[e.to].push({   id: e.from, weight: e.weight }); // bidirectional
      }
    });

    const dist  = {};
    const prev  = {};
    const visited = new Set();
    const queue = [];

    nodes.forEach(n => { dist[n.id] = Infinity; prev[n.id] = null; });
    dist[startId] = 0;
    queue.push({ id: startId, dist: 0 });

    while (queue.length > 0) {
      // get node with smallest distance
      queue.sort((a, b) => a.dist - b.dist);
      const current = queue.shift();

      if (visited.has(current.id)) continue;
      visited.add(current.id);

      if (current.id === endId) break;

      const neighbors = graph[current.id] || [];
      for (const neighbor of neighbors) {
        if (visited.has(neighbor.id)) continue;
        const newDist = dist[current.id] + neighbor.weight;
        if (newDist < dist[neighbor.id]) {
          dist[neighbor.id] = newDist;
          prev[neighbor.id] = current.id;
          queue.push({ id: neighbor.id, dist: newDist });
        }
      }
    }

    // Reconstruct path
    if (dist[endId] === Infinity) return null;

    const path = [];
    let current = endId;
    while (current !== null) {
      path.unshift(current);
      current = prev[current];
    }

    return path.length > 1 ? path : null;
  }
};

window.dijkstra = dijkstra;
